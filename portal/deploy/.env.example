# Copy to .env next to compose.yaml. .env is never committed.
DYNU_HOSTNAME=x-piratez.mywire.org
# SHA-256 of the IP update password (Dynu: Control Panel -> Manage Credentials).
# Linux: printf '%s' 'the-password' | sha256sum
DYNU_PASSWORD_SHA256=
# or the plain password instead (hashed inside the container, never sent in clear):
# DYNU_PASSWORD=
DYNU_INTERVAL=300
DYNU_FORCE_DAYS=7
# time zone for log timestamps
TZ=UTC
