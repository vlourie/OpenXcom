# Copy to .env next to compose.yaml. .env is never committed.
DYNU_HOSTNAME=x-piratez.mywire.org

# Either an API key (Dynu Control Panel -> API Credentials -> API Key) ...
DYNU_API_KEY=
# ... or the IP update password (Control Panel -> Manage Credentials), as its SHA-256:
#   printf '%s' 'the-password' | sha256sum
# DYNU_PASSWORD_SHA256=
# or in plain text (hashed inside the container, never sent in clear):
# DYNU_PASSWORD=

DYNU_INTERVAL=300
# time zone for log timestamps
TZ=UTC
