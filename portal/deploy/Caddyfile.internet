# HTTPS for a test station reachable from the internet (compose.internet.yaml): a real Let's Encrypt
# certificate for PORTAL_HOST, proven through Dynu's DNS API, on a port other than 443.
# own_domain: for a name under Dynu's shared domains (x-piratez.mywire.org) the zone Caddy finds is
# mywire.org, which is not in the account - the module has to be told the account's own name.
{
	auto_https disable_redirects
	# No HTTP/3: inside the container Caddy listens on 443 and advertises Alt-Svc h3=":443", but the
	# station publishes it on another port - clients would try QUIC on a port that is not ours.
	servers {
		protocols h1 h2
	}
}

{$PORTAL_HOST} {
	tls {
		dns dynu {
			api_token {$DYNU_API_KEY}
			own_domain {$PORTAL_HOST}
		}
		# public resolvers: the machine's own DNS may cache the absence of the TXT record
		resolvers 1.1.1.1 8.8.8.8
	}
	# release repository (xp-release): plain files, Range requests for resumed downloads.
	# Not compressed: blobs are fetched by byte ranges and checked by hash, gzip would break both
	handle_path /releases/* {
		root * /srv/releases
		# a blob is named by its hash and never changes; channels and manifests' status do
		header /blobs/* Cache-Control "public, max-age=31536000, immutable"
		header /channels/* Cache-Control "no-cache"
		header /catalog.json* Cache-Control "no-cache"
		file_server
	}
	handle {
		encode zstd gzip
		# uploads are limited by the portal itself; this only stops absurd bodies at the door
		request_body {
			max_size 600MB
		}
		reverse_proxy portal:8080
	}
}

# The same repository for the portal itself, inside the Docker network only (not published):
# the site reads its releases without going out to its own public address and back through
# the router, which many routers do not allow
:8081 {
	root * /srv/releases
	file_server
}
