# Copy to portal.env next to compose.yaml. portal.env is never committed.
# Names are the site's settings (appsettings.json), with "__" between levels.

# Server secret: guest ticket links and signed file links are derived from it.
# Generate once:  openssl rand -base64 48
# Changing it later makes every guest link already sent stop working.
Portal__Secret=

# Where the "Download launcher" button leads (empty = no button)
Portal__LauncherDownloadUrl=
# Release repository for the "current version" block: URL of the tree xp-release builds
Portal__ReleaseRepo=
Portal__ReleaseChannel=stable
# "prod" public keys from portal/keys/release-keys.txt, one per index
Portal__ReleaseKeys__0=

# Telegram: bot token from @BotFather. Chats and threads are set on the site: Management -> Telegram.
# Empty = notices wait in the queue and are not sent.
Telegram__BotToken=

# Mail for e-mail confirmation and password reset
Email__From=noreply@x-piratez.mywire.org
Email__SmtpHost=
Email__SmtpPort=587
Email__SmtpUser=
Email__SmtpPassword=

# Attachment limits (defaults shown; bytes)
# Attachments__MaxFileBytes=52428800
# Attachments__MaxZipBytes=104857600
# Attachments__MaxFilesPerTicket=10
# Attachments__MaxBytesPerTicket=209715200

# Password hashing cost (defaults: 65536 KiB, 3 passes)
# Argon2__MemoryKib=65536
# Argon2__Iterations=3
