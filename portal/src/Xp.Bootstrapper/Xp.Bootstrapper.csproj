<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>xp-bootstrap</AssemblyName>
    <!-- the setup the site gives a new player: the launcher's icon, not the blank one of a plain exe -->
    <ApplicationIcon>..\Xp.Launcher\Assets\app.ico</ApplicationIcon>
    <RootNamespace>Xp.Bootstrapper</RootNamespace>
    <!-- the site gives it out as XPiratezHD-Setup-<launcher version>.exe: the same number in its properties,
         read from the launcher's project so the version is raised in one place -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\Xp.Launcher\Xp.Launcher.csproj')), '&lt;Version&gt;([^&lt;]+)&lt;/Version&gt;').Groups[1].Value)</Version>
    <AssemblyTitle>X-Piratez HD Setup</AssemblyTitle>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- the shell link for shortcuts is source-generated COM (Installer.cs) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- the same key rule as the launcher: dev keys only in Debug or with -p:AllowDevKeys=true -->
    <AllowDevKeys Condition="'$(AllowDevKeys)' == ''">false</AllowDevKeys>
    <DefineConstants Condition="'$(Configuration)' == 'Debug' Or '$(AllowDevKeys)' == 'true'">$(DefineConstants);ALLOW_DEV_KEYS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- SafePath and signatures from the manifest library, the release client from Launcher.Core; both AOT-clean -->
    <ProjectReference Include="..\Xp.Manifest\Xp.Manifest.csproj" />
    <ProjectReference Include="..\Xp.Launcher.Core\Xp.Launcher.Core.csproj" />
    <!-- referenced directly only for its path: the setup is one downloaded file and carries libsodium inside -->
    <PackageReference Include="libsodium" Version="1.0.20.1" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Xp.Launcher.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- the install mode (no arguments) reads the same server and keys the launcher is built with -->
    <EmbeddedResource Include="..\..\keys\release-keys.txt" LogicalName="release-keys.txt" />
    <EmbeddedResource Include="..\Xp.Launcher\defaults.json" LogicalName="defaults.json" />
    <EmbeddedResource Include="$(PkgLibsodium)\runtimes\win-x64\native\libsodium.dll" LogicalName="libsodium.dll" />
  </ItemGroup>
</Project>
