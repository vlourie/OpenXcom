<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>xp-bootstrap</AssemblyName>
    <RootNamespace>Xp.Bootstrapper</RootNamespace>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>
  <ItemGroup>
    <!-- only SafePath is used; the manifest library is small and AOT-clean -->
    <ProjectReference Include="..\Xp.Manifest\Xp.Manifest.csproj" />
  </ItemGroup>
</Project>
