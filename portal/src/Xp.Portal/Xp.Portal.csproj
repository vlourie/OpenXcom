<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Xp.Portal</RootNamespace>
    <AssemblyName>Xp.Portal</AssemblyName>
    <UserSecretsId>xp-portal-dev</UserSecretsId>
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Xp.Manifest\Xp.Manifest.csproj" />
    <ProjectReference Include="..\Xp.Launcher.Core\Xp.Launcher.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Strings\*.json" LogicalName="strings.%(Filename).json" />
    <Content Remove="Strings\*.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Xp.Portal.Tests" />
  </ItemGroup>
</Project>
