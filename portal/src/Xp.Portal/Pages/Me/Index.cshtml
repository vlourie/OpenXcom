@page "/me"
@model Xp.Portal.Pages.Me.MyTicketsModel
@{
    ViewData["Title"] = T["nav.my"];
}
<h1>@T["nav.my"]</h1>
@if (Model.Tickets.Count == 0)
{
    <p class="hint">@T["my.empty"]</p>
}
else
{
    <table>
        <tr><th>№</th><th>@T["field.title"]</th><th>@T["field.category"]</th><th>@T["field.status"]</th><th>@T["field.updated"]</th></tr>
        @foreach (var t in Model.Tickets)
        {
            <tr>
                <td><a href="/t/@t.Number">@t.DisplayNumber</a></td>
                <td>@t.Title</td>
                <td>@T["cat." + t.Category]</td>
                <td>@T["status." + t.Status]</td>
                <td>@t.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
            </tr>
        }
    </table>
}
<a class="button" href="/tickets/new">@T["nav.report"]</a>

<section class="panel">
    <h2 class="title">@T["me.review.title"]</h2>
    @if (Model.Review.Packs == 0)
    {
        <p class="hint">@T["me.review.none"]</p>
    }
    else
    {
        <div class="stats">
            <div><div class="k">@T["me.review.packs"]</div><div class="v">@Model.Review.Packs</div></div>
            <div><div class="k">@T["me.review.pictures"]</div><div class="v">@Model.Review.Pictures</div></div>
            <div><div class="k">@T["me.review.bad"]</div><div class="v">@Model.Review.Bad</div></div>
            <div><div class="k">@T["me.review.repaint"]</div><div class="v">@Model.Review.WentToRepaint</div></div>
            @if (Model.Review.Last is { } last)
            {
                <div><div class="k">@T["me.review.last"]</div><div class="v">@last.ToString("yyyy-MM-dd")</div></div>
            }
        </div>
    }
    <a class="button secondary" href="/roadmap">@T["nav.roadmap"]</a>
</section>
