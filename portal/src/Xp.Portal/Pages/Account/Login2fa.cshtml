@page "/account/login2fa"
@model Xp.Portal.Pages.Account.Login2faModel
@{
    ViewData["Title"] = T["login2fa.title"];
}
<h1>@T["login2fa.title"]</h1>
<partial name="_Errors" model="Model.Errors" />
<form method="post" class="panel">
    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
    <label for="Code">@T["login2fa.code"]</label>
    <input type="text" id="Code" name="Code" required inputmode="numeric" autocomplete="one-time-code" maxlength="32" />
    <label class="check">
        <input type="checkbox" name="Recovery" value="true" />
        <span>@T["login2fa.recovery"]</span>
    </label>
    <button type="submit">@T["login.submit"]</button>
</form>
