@page "/account/confirm"
@model Xp.Portal.Pages.Account.ConfirmModel
@{
    ViewData["Title"] = T["confirm.title"];
}
<h1>@T["confirm.title"]</h1>
@if (Model.Ok)
{
    <p class="flash">@T["confirm.ok"]</p>
    <a class="button" href="@Model.LoginUrl">@T["nav.login"]</a>
}
else
{
    <p class="errors">@T["confirm.bad"]</p>
    <p><a href="/account/resend">@T["resend.title"]</a></p>
}
