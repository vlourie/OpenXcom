<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>XPiratezLauncher</AssemblyName>
    <RootNamespace>Xp.Launcher</RootNamespace>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- OXCE HD over the geoscape globe: tools/launcher_icon.py ico oxce_globe (16..256) -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.3.9</Version>
    <!-- dev keys are trusted only in Debug or when explicitly allowed for a local test build -->
    <AllowDevKeys Condition="'$(AllowDevKeys)' == ''">false</AllowDevKeys>
    <DefineConstants Condition="'$(Configuration)' == 'Debug' Or '$(AllowDevKeys)' == 'true'">$(DefineConstants);ALLOW_DEV_KEYS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Xp.Launcher.Core\Xp.Launcher.Core.csproj" />
  </ItemGroup>
  <!-- voice rooms (the Voice page): livekit_ffi.dll and xpaudio.dll come along into the output -->
  <ItemGroup>
    <ProjectReference Include="..\Xp.Voice\Xp.Voice.csproj" />
  </ItemGroup>
  <!-- the prototype window (the voice switch with a token from the command line) is a developer's tool: Debug only,
       so a player's launcher never enters a room with a token it did not get from the site -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="VoiceWindow.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\keys\release-keys.txt" LogicalName="release-keys.txt" />
    <EmbeddedResource Include="Strings\*.json" LogicalName="strings.%(Filename).json" />
    <EmbeddedResource Include="defaults.json" LogicalName="defaults.json" />
    <!-- Roboto, the HD interface font, cut to Latin and Cyrillic (~30 KB each) -->
    <AvaloniaResource Include="Assets\Fonts\*.ttf" />
    <!-- the home card art: tools/hdart/gen_promo.py, indigo duotone, <= 400 KB -->
    <AvaloniaResource Include="Assets\hero.jpg" />
    <AvaloniaResource Include="Assets\setup_*.jpg" />
    <AvaloniaResource Include="Assets\app.ico" />
  </ItemGroup>
  <!-- rendering is WGL/software (Program.cs), ANGLE is never loaded -->
  <Target Name="DropAngle" AfterTargets="Publish">
    <Delete Files="$(PublishDir)av_libglesv2.dll" />
  </Target>
  <Target Name="RequireProdKey" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release' And '$(AllowDevKeys)' != 'true'">
    <ReadLinesFromFile File="..\..\keys\release-keys.txt">
      <Output TaskParameter="Lines" ItemName="KeyLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <KeyText>@(KeyLines, '|')</KeyText>
    </PropertyGroup>
    <Error Condition="!$(KeyText.Contains('|prod ')) And !$(KeyText.StartsWith('prod '))"
           Text="keys/release-keys.txt has no 'prod' key: a Release launcher would trust nothing. Add the production public key, or build with -p:AllowDevKeys=true for a local test." />
  </Target>
</Project>
