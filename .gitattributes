# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.cpp text
*.h text
*.rc text

# Замки модели обрушения (census/collapse/**/*.lock.txt) хэшируют байты файла, а не текст (грабли R-252):
# при выкладке концы строк обязаны быть те, с которыми записан замок. collapse_v2.py и collapse_ctype_marks.py заперты в CRLF, остальные в LF.
# Проверка - tools/test_collapse_lock_eol.py.
tools/collapse_*.py text eol=lf
tools/collapse_v2.py text eol=crlf
tools/collapse_ctype_marks.py text eol=crlf

# Declare files that will always have CRLF line endings on checkout.
*.sln text eol=crlf
*.vcxproj* text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.gif binary
