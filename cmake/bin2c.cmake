# Writes a binary file as a C array: cmake -DIN=<file> -DOUT=<file.c> -DNAME=<symbol> -P bin2c.cmake
# (the packed collapse pilot table, src/Battlescape/CollapsePilotData.cpp)
file ( READ "${IN}" hex HEX )
string ( LENGTH "${hex}" len )
math ( EXPR size "${len} / 2" )
string ( REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}" )
string ( REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}" )
file ( WRITE "${OUT}" "/* generated by cmake/bin2c.cmake from ${IN} */\nconst unsigned char ${NAME}[] = {\n${bytes}\n};\nconst unsigned long ${NAME}_size = ${size};\n" )
