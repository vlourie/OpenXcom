+/* OXCE: a read past the end of the file gives 0, which ends every list of offsets and is PROP_END
+   (SDL_ReadBE32 of SDL 1.2 gives back what its variable held - the lists then never end) */
+static Uint32 xcf_read_be32 (SDL_RWops * src) {
+  Uint32 v = 0;
+  if (SDL_RWread (src, &v, sizeof (v), 1) != 1)
+    return 0;
+  return SDL_SwapBE32 (v);
+}
+#define SDL_ReadBE32 xcf_read_be32
 
