 	SDL_RWops *src;
 
 	src = (SDL_RWops *)lib.png_get_io_ptr(ctx);
-	SDL_RWread(src, area, size, 1);
+	/* OXCE: past the end of the file libpng gets zeros, not what its buffer held before: a chunk header left
+	   there from the last read is taken for the next chunk again and again, without an end. Zeros are a chunk
+	   of no type, which libpng refuses. (upstream main raises png_error at this place, 99982b9b) */
+	if ( SDL_RWread(src, area, size, 1) != 1 ) {
+		memset(area, 0, size);
+	}
 }
 
