+void SavedBattleGame::benchLogResult(const char* why, int abort, int inExit) const
+{
+	// BOXCE-BENCH: исход боя одной строкой. Пишется на КАЖДОМ выходе из боя,
+	// иначе прогон, кончившийся не так, как ждали, молча выпадает из статистики
+	int cnt[4][3] = {};   // фракция -> живые, без сознания, убитые
+	for (const auto* unit : _units)
+	{
+		int f = (int)unit->getOriginalFaction();
+		if (f < 0 || f > 3)
+			continue;
+		if (unit->getStatus() == STATUS_DEAD)
+			++cnt[f][2];
+		else if (unit->getStatus() == STATUS_UNCONSCIOUS)
+			++cnt[f][1];
+		else
+			++cnt[f][0];
+	}
+	Log(LOG_INFO) << "[AIRESULT] why=" << why
+		<< " turns=" << _turn
+		<< " abort=" << abort
+		<< " inExit=" << inExit
+		<< " xcomAlive=" << cnt[FACTION_PLAYER][0]
+		<< " xcomStunned=" << cnt[FACTION_PLAYER][1]
+		<< " xcomDead=" << cnt[FACTION_PLAYER][2]
+		<< " alienAlive=" << cnt[FACTION_HOSTILE][0]
+		<< " alienStunned=" << cnt[FACTION_HOSTILE][1]
+		<< " alienDead=" << cnt[FACTION_HOSTILE][2]
+		<< " civAlive=" << cnt[FACTION_NEUTRAL][0]
+		<< " civDead=" << cnt[FACTION_NEUTRAL][2];
+}
