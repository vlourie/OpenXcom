+// --- BOXCE-BENCH: профайлер времени ИИ -------------------------------------
+namespace
+{
+	struct AiProfSlot { long long usTotal = 0; long long usMax = 0; int calls = 0; long long reachSum = 0; int reachMax = 0; };
+	AiProfSlot g_aiProf[4];
+}
+
+void aiProfAdd(int faction, long long us, int reachable)
+{
+	if (faction < 0 || faction > 3) return;
+	AiProfSlot &p = g_aiProf[faction];
+	p.usTotal += us;
+	if (us > p.usMax) p.usMax = us;
+	p.calls++;
+	p.reachSum += reachable;
+	if (reachable > p.reachMax) p.reachMax = reachable;
+}
+
+void aiProfDump(int turn, int faction)
+{
+	if (faction < 0 || faction > 3) return;
+	AiProfSlot &p = g_aiProf[faction];
+	if (p.calls == 0) return;
+	const char *fname = (faction == 0) ? "PLAYER" : (faction == 1) ? "HOSTILE" : "NEUTRAL";
+	Log(LOG_INFO) << "[AIBENCH] turn=" << turn
+		<< " side=" << fname
+		<< " brutal=" << Options::brutalAI
+		<< " perfOpt=" << (Options::aiPerformanceOptimization ? 1 : 0)
+		<< " cheat=" << Options::aiCheatMode
+		<< " calls=" << p.calls
+		<< " totalMs=" << (p.usTotal / 1000)
+		<< " avgMs=" << (p.usTotal / 1000.0 / p.calls)
+		<< " maxMs=" << (p.usMax / 1000)
+		<< " avgReach=" << (p.calls ? p.reachSum / p.calls : 0)
+		<< " maxReach=" << p.reachMax;
+	p = AiProfSlot();
+}
+
+namespace
+{
+	struct AiProfScope
+	{
+		int faction; const std::vector<int> *reach;
+		std::chrono::steady_clock::time_point t0;
+		AiProfScope(int f, const std::vector<int> *r) : faction(f), reach(r), t0(std::chrono::steady_clock::now()) {}
+		~AiProfScope()
+		{
+			auto us = std::chrono::duration_cast<std::chrono::microseconds>(
+				std::chrono::steady_clock::now() - t0).count();
+			aiProfAdd(faction, (long long)us, reach ? (int)reach->size() : 0);
+		}
+	};
+}
+namespace
+{
+	// BOXCE-BENCH: отпечаток решения. Сколько раз спросят ИИ за ход - зависит от кадров
+	// (грабли R-025), поэтому сравнивать сборки можно только по ПЕРВОМУ решению юнита
+	// в ходу: состояние в этот момент у всех сборок одно и то же.
+	std::map<int, int> g_aiDecideTurn;
+
+	struct AiDecideScope
+	{
+		const BattleUnit* unit; const BattleAction* action; int turn; bool write;
+		AiDecideScope(const BattleUnit* u, const BattleAction* a, int t)
+			: unit(u), action(a), turn(t), write(false)
+		{
+			if (!Options::aiBench) return;
+			auto it = g_aiDecideTurn.find(u->getId());
+			if (it != g_aiDecideTurn.end() && it->second == turn) return;
+			g_aiDecideTurn[u->getId()] = turn;
+			write = true;
+		}
+		~AiDecideScope()
+		{
+			if (!write) return;
+			Log(LOG_INFO) << "[AIDECIDE] turn=" << turn
+				<< " side=" << (int)unit->getFaction()
+				<< " unit=" << unit->getId()
+				<< " from=" << unit->getPosition()
+				<< " type=" << (int)action->type
+				<< " target=" << action->target;
+		}
+	};
+}
+namespace
+{
+	// BOXCE-BENCH: getReachableBy отдаёт ссылку, по const-карте operator[] не берётся;
+	// отсутствующая клетка - это ноль, ровно как раньше давал operator[] у копии
+	inline int tuAtOrZero(const std::map<Position, int, PositionComparator>& reachable, Position pos)
+	{
+		auto it = reachable.find(pos);
+		return it != reachable.end() ? it->second : 0;
+	}
+
+	// фазы brutalThink: 0 ожидание союзника, 1 построение достижимости,
+	// 2 предобход юнитов, 3 главный перебор позиций
+	long long g_aiPhaseUs[4] = {0, 0, 0, 0};
+	long long g_aiPhaseCalls[4] = {0, 0, 0, 0};
+	long long g_aiPosScanned = 0;
+	// BOXCE-FAIR: сколько оценок урона прошло вслепую и сколько по настоящим числам
+	long long g_aiFairBlind = 0;
+	long long g_aiFairKnown = 0;
+	// BOXCE-BENCH: сколько на самом деле стоит оценка урона. R-012: цену называем
+	// по замеру, а не по тому, что функция выглядит дорогой
+	long long g_aiDmgPotUs = 0;
+	// BOXCE-BENCH: сколько раз карта достижимых клеток взята из кэша, а сколько
+	// посчитана заново разливом по карте
+	long long g_aiReachHit = 0;
+	long long g_aiReachMiss = 0;
+
+	struct AiPhaseTimer
+	{
+		int phase; bool running;
+		std::chrono::steady_clock::time_point t0;
+		AiPhaseTimer(int p) : phase(p), running(true), t0(std::chrono::steady_clock::now()) {}
+		void stop()
+		{
+			if (!running) return;
+			running = false;
+			g_aiPhaseUs[phase] += std::chrono::duration_cast<std::chrono::microseconds>(
+				std::chrono::steady_clock::now() - t0).count();
+			g_aiPhaseCalls[phase]++;
+		}
+		~AiPhaseTimer() { stop(); }
+	};
+}
+
+void aiPhaseDump()
+{
+	if (g_aiPhaseCalls[0] == 0) return;
+	Log(LOG_INFO) << "[AIPHASE] waitAllyMs=" << (g_aiPhaseUs[0] / 1000)
+		<< " reachMs=" << (g_aiPhaseUs[1] / 1000)
+		<< " unitScanMs=" << (g_aiPhaseUs[2] / 1000)
+		<< " posLoopMs=" << (g_aiPhaseUs[3] / 1000)
+		<< " posScanned=" << g_aiPosScanned
+		<< " posLoopRuns=" << g_aiPhaseCalls[3]
+		<< " fairBlind=" << g_aiFairBlind
+		<< " fairKnown=" << g_aiFairKnown
+		<< " dmgPotMs=" << (g_aiDmgPotUs / 1000)
+		<< " reachHit=" << g_aiReachHit
+		<< " reachMiss=" << g_aiReachMiss;
+	for (int i = 0; i < 4; ++i) { g_aiPhaseUs[i] = 0; g_aiPhaseCalls[i] = 0; }
+	g_aiPosScanned = 0;
+	g_aiFairBlind = 0;
+	g_aiFairKnown = 0;
+	g_aiDmgPotUs = 0;
+	g_aiReachHit = 0;
+	g_aiReachMiss = 0;
+}
