+	// COVER_STEP_V1 (bench, OXCE_AI_COVER_STEP, the enemy only): a selection starts with the first counted action; the extra
+	// action maxActions gave after the selection's last attack is the step into cover and nothing else - no other think runs
+	const bool coverOn = AiProbe::coverStep() && _unit->getFaction() == FACTION_HOSTILE;
+	if (coverOn)
+	{
+		if (action->number == 1 || _coverTurn != _save->getTurn())
+		{
