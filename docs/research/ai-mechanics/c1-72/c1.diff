+			_coverAttacked = false;
+			_coverDone = false;
+		}
+		if (action->number > 2 && coverStepPending())
+		{
+			action->type = BA_NONE;
+			action->actor = _unit;
+			_visibleEnemies = selectNearestTarget();
+			coverStepTake(action);
+			return;
+		}
+	}
+
 	action->type = BA_RETHINK;
 	action->actor = _unit;
 	action->weapon = _unit->getMainHandWeapon(false);
@@ -1422,6 +1443,144 @@
 	{
 		AiProbe::tally(_unit, "fpblocked.other_branch");
 	}
+	// COVER_STEP_V1: a shot or a throw makes the step due, a walk elsewhere (a fire point, escape, ambush) cancels it; a
+	// selection that would end here, standing, takes the step in place of the end
+	if (coverOn)
+	{
+		switch (action->type)
+		{
+		case BA_SNAPSHOT:
+		case BA_AUTOSHOT:
+		case BA_AIMEDSHOT:
+		case BA_THROW:
+		case BA_LAUNCH:
+			_coverAttacked = true;
+			break;
+		case BA_WALK:
+			_coverAttacked = false;
+			break;
+		case BA_NONE:
+			if (coverStepPending())
+			{
+				coverStepTake(action);
+			}
+			break;
+		default:
+			break;
+		}
+	}
+}
+
+bool AIModule::coverStepPending() const
+{
+	return _coverAttacked && !_coverDone && _coverTurn == _save->getTurn();
+}
+
+bool AIModule::coverStepTake(BattleAction *action)
+{
+	_coverDone = true;
+	const Position from = _unit->getPosition();
+	// the threats are the enemies its side sees now: their places are known to it. getSpottingUnits is not used - it takes
+	// every unit known by the intelligence rule where it really stands, also one that walked off out of sight
+	std::vector<BattleUnit*> threats;
+	for (auto *bu : *_save->getUnits())
+	{
+		if (!validTarget(bu, false, false))
+			continue;
+		for (auto *mate : *_save->getUnits())
+		{
+			if (mate->getFaction() == _unit->getFaction() && !mate->isOut()
+				&& std::find(mate->getVisibleUnits()->begin(), mate->getVisibleUnits()->end(), bu) != mate->getVisibleUnits()->end())
+			{
+				threats.push_back(bu);
+				break;
+			}
+		}
+	}
+	// how many of them have a line of fire to the unit standing at pos - the trace of getSpottingUnits
+	auto linesOfFire = [&](const Position &pos)
+	{
+		int n = 0;
+		for (auto *bu : threats)
+		{
+			if (Position::distance2d(pos, bu->getPosition()) > 20)
+				continue;
+			Position originVoxel = _save->getTileEngine()->getSightOriginVoxel(bu);
+			originVoxel.z -= 2;
+			Position targetVoxel;
+			n += _save->getTileEngine()->canTargetUnit(&originVoxel, _save->getTile(pos), &targetVoxel, bu, false,
+				pos != from ? _unit : 0) ? 1 : 0;
+		}
+		return n;
+	};
+	const int seenBy = linesOfFire(from);
+	if (seenBy == 0 || !_unit->getArmor()->allowsMoving())
+	{
+		AiProbe::tally(_unit, seenBy == 0 ? "cover.unseen" : "cover.immobile");
+		return false;
+	}
+	// a snap shot's time units stay for reaction fire on the enemy's turn
+	BattleActionCost keep;
+	BattleItem *weapon = _unit->getMainHandWeapon(false);
+	if (weapon && weapon->getRules()->getBattleType() == BT_FIREARM)
+	{
+		keep = BattleActionCost(BA_SNAPSHOT, _unit, weapon);
+	}
+	// the tiles come cheapest first; the lines of fire are traced to the first COVER_TRIES of them at most
+	const int COVER_TRIES = 40;
+	int tried = 0;
+	const std::vector<int> reach = _save->getPathfinding()->findReachable(_unit, keep);
+	for (int index : reach)
+	{
+		const Position pos = _save->getTileCoords(index);
+		const Tile *tile = _save->getTile(pos);
+		if (pos == from || !tile || tile->getFire() || tile->getDangerous())
+			continue;
+		if (++tried > COVER_TRIES)
+			break;
+		if (linesOfFire(pos) != 0)
+			continue;
+		_save->getPathfinding()->calculate(_unit, pos, BAM_NORMAL);
+		const bool path = _save->getPathfinding()->getStartDirection() != -1;
+		const int cost = _save->getPathfinding()->getTotalTUCost();
+		_save->getPathfinding()->abortPath();
+		if (!path)
+			continue;
+		action->type = BA_WALK;
+		action->target = pos;
+		action->run = false;
+		action->kneel = false;
+		action->desperate = true; // to the tile, not stopping at the next enemy spotted on the way
+		action->finalAction = true; // the unit's turn ends there
+		// facing the nearest threat it sees now (the turn at the walk's end is the one every AI walk makes, as before)
+		action->finalFacing = -1;
+		int nearest = INT_MAX;
+		for (auto *bu : threats)
+		{
+			const int d = Position::distanceSq(pos, bu->getPosition());
+			if (d < nearest && bu->getPosition() != pos)
+			{
+				nearest = d;
+				action->finalFacing = _save->getTileEngine()->getDirectionTo(pos, bu->getPosition());
+			}
+		}
+		_unit->setHiding(false); // facing the enemy, not the 180 spin of an escape
+		_escapeTUs = 0;
+		_ambushTUs = 0;
+		if (AiProbe::staleEscapeFix())
+			_escapePlan.valid = false;
+		AiProbe::tally(_unit, "cover.step");
+		AiProbe::note(_unit, ("cover.step seen=" + std::to_string(seenBy) + " tried=" + std::to_string(tried)
+			+ " dist=" + std::to_string(Position::distance2d(from, pos)) + " cost=" + std::to_string(cost)
+			+ " keep=" + std::to_string(keep.Time) + " tu=" + std::to_string(_unit->getTimeUnits())).c_str());
+		return true;
+	}
+	// no step at all with the reserve kept (time units or energy), or steps but none out of the lines of fire
+	const bool noStep = reach.size() <= 1;
+	AiProbe::tally(_unit, noStep ? "cover.none.tu" : "cover.none.cell");
+	AiProbe::note(_unit, ((noStep ? "cover.none.tu" : "cover.none.cell") + std::string(" seen=") + std::to_string(seenBy)
+		+ " tried=" + std::to_string(tried) + " keep=" + std::to_string(keep.Time) + " tu=" + std::to_string(_unit->getTimeUnits())).c_str());
+	return false;
 }
 
 
