+std::vector<BattleUnit*> AIModule::c2Threats() const
+{
+	std::vector<BattleUnit*> threats;
+	for (auto *bu : *_save->getUnits())
+	{
+		if (!validTarget(bu, false, false))
+			continue;
+		for (auto *mate : *_save->getUnits())
+		{
+			if (mate->getFaction() == _unit->getFaction() && !mate->isOut()
+				&& std::find(mate->getVisibleUnits()->begin(), mate->getVisibleUnits()->end(), bu) != mate->getVisibleUnits()->end())
+			{
+				threats.push_back(bu);
+				break;
+			}
+		}
+	}
+	return threats;
+}
+
+int AIModule::c2Lof(const std::vector<BattleUnit*> &threats, const Position &pos) const
+{
+	int n = 0;
+	for (auto *bu : threats)
+	{
+		if (Position::distance2d(pos, bu->getPosition()) > 20)
+			continue;
+		Position originVoxel = _save->getTileEngine()->getSightOriginVoxel(bu);
+		originVoxel.z -= 2;
+		Position targetVoxel;
+		n += _save->getTileEngine()->canTargetUnit(&originVoxel, _save->getTile(pos), &targetVoxel, bu, false,
+			pos != _unit->getPosition() ? _unit : 0) ? 1 : 0;
+	}
+	return n;
+}
+
+namespace
+{
+/// The time units and energy the walk calculate() just found takes, step by step as the walk spends them.
+PathfindingCost c2WalkCost(Pathfinding *pf, const BattleUnit *unit)
+{
+	PathfindingCost total;
+	Position p = unit->getPosition();
+	const std::vector<int> &path = pf->getPath();
+	for (auto it = path.rbegin(); it != path.rend(); ++it) // paths are stored in reverse order
+	{
+		PathfindingStep r = pf->getTUCost(p, *it, unit, nullptr, BAM_NORMAL);
+		total = total + r.cost;
+		p = r.pos;
+	}
+	return total;
+}
+}
+
+void AIModule::c2Plan()
+{
+	const bool shotHere = _attackAction.type == BA_SNAPSHOT || _attackAction.type == BA_AUTOSHOT || _attackAction.type == BA_AIMEDSHOT;
+	const bool fpWalk = _attackAction.type == BA_WALK && _firepointChosen && _attackAction.target == _firepointChosenAt;
+	if (!(shotHere || fpWalk) || !_rifle || !_aggroTarget || !_attackAction.weapon || !_unit->getArmor()->allowsMoving())
+		return;
+	BattleUnit *target = _aggroTarget;
+	if (shotHere)
+	{
+		const Tile *tt = _save->getTile(_attackAction.target);
+		if (tt && tt->getUnit())
+			target = tt->getUnit();
+	}
+	// the target and the threats: only enemies its side sees now
+	const std::vector<BattleUnit*> threats = c2Threats();
+	if (std::find(threats.begin(), threats.end(), target) == threats.end())
+	{
+		AiProbe::tally(_unit, "c2.skip.unseen");
+		return;
+	}
+	const BattleActionType mode = shotHere ? _attackAction.type : BA_SNAPSHOT; // findFirePoint walks for a snap shot
+	const BattleActionCost shot(mode, _unit, _attackAction.weapon);
+	if (shot.Time <= 0)
+		return;
+	const Position here = _unit->getPosition();
+	const Position fire = shotHere ? here : _attackAction.target;
+	std::map<int, int> lofMemo;
+	auto lof = [&](const Position &pos)
+	{
+		const int index = _save->getTileIndex(pos);
+		auto it = lofMemo.find(index);
+		if (it == lofMemo.end())
+			it = lofMemo.emplace(index, c2Lof(threats, pos)).first;
+		return it->second;
+	};
+	const int seenFire = lof(fire);
+	if (seenFire == 0)
+	{
+		AiProbe::tally(_unit, "c2.skip.safe");
+		return;
+	}
+	auto exitCell = [&](const Position &pos)
+	{
+		const Tile *tile = _save->getTile(pos);
+		return tile && !tile->getFire() && !tile->getDangerous() && (!tile->getUnit() || tile->getUnit() == _unit) && lof(pos) == 0;
+	};
+	// kneeling for an aimed or auto shot costs its time units, the walk out stands up first
+	const bool kneels = (mode == BA_AIMEDSHOT || mode == BA_AUTOSHOT) && _unit->getArmor()->allowsKneeling(false) && !_unit->isFloating();
+	const int kneelDown = kneels && !_unit->isKneeled() ? _unit->getKneelDownCost() : 0;
+	const int stand = kneels || _unit->isKneeled() ? _unit->getKneelUpCost() : 0;
+	const int tu = _unit->getTimeUnits();
+	Pathfinding *pf = _save->getPathfinding();
+	// the cells reachable with a shot's time units kept, and the walk's cost to each
+	std::map<int, int> reachTu;
+	for (int index : pf->findReachable(_unit, shot))
+	{
+		reachTu[index] = pf->reachedTU(_save->getTileCoords(index));
+	}
+	auto shotsAfter = [&](int walk)
+	{
+		const int left = tu - walk - kneelDown;
+		return left >= shot.Time ? left / shot.Time : 0;
+	};
+	const int walkFire = shotHere ? 0 : (reachTu.count(_save->getTileIndex(fire)) ? reachTu[_save->getTileIndex(fire)] : -1);
+	if (walkFire < 0)
+		return;
+	const int shots = shotsAfter(walkFire);
+	if (shots == 0)
+		return;
+	// the exit from a cell the unit does not stand on: one or two steps by the engine's own step cost
+	auto exitFrom = [&](const Position &from, int budget)
+	{
+		int best = INT_MAX;
+		std::vector<std::pair<Position, int>> ring;
+		for (int dir = 0; dir < 8; ++dir)
+		{
+			PathfindingStep r = pf->getTUCost(from, dir, _unit, nullptr, BAM_NORMAL);
+			if (r.cost.time <= 0 || r.cost.time >= Pathfinding::INVALID_MOVE_COST || r.cost.time > budget)
+				continue;
+			ring.emplace_back(r.pos, r.cost.time);
+			if (r.cost.time < best && exitCell(r.pos))
+				best = r.cost.time;
+		}
+		for (const auto &one : ring)
+		{
+			for (int dir = 0; dir < 8; ++dir)
+			{
+				PathfindingStep r = pf->getTUCost(one.first, dir, _unit, nullptr, BAM_NORMAL);
+				const int t = one.second + r.cost.time;
+				if (r.cost.time <= 0 || r.cost.time >= Pathfinding::INVALID_MOVE_COST || t > budget || t >= best || r.pos == from)
+					continue;
+				if (exitCell(r.pos))
+					best = t;
+			}
+		}
+		return best;
+	};
+	// the exit from where it stands: the engine's reachable cells, cheapest first
+	auto exitHere = [&](int budget)
+	{
+		BattleActionCost keep;
+		keep.Time = tu - budget;
+		int tried = 0;
+		for (int index : pf->findReachable(_unit, keep))
+		{
+			const Position pos = _save->getTileCoords(index);
+			if (pos == here)
+				continue;
+			if (++tried > 40)
+				break;
+			if (exitCell(pos))
+				return pf->reachedTU(pos);
+		}
+		return INT_MAX;
+	};
+	const int leftFire = tu - walkFire - kneelDown - shots * shot.Time - stand;
+	const int exitFire = leftFire <= 0 ? INT_MAX : fire == here ? exitHere(leftFire) : exitFrom(fire, leftFire);
+	const int turn = _save->getTurn();
+	if (exitFire != INT_MAX)
+	{
+		// the fire cell setupAttack chose keeps the way out after its shots: the plan is that cell
+		_c2Fire = fire;
+		_c2Turn = turn;
+		_c2Kind = shotHere ? 1 : 2;
+		_c2Phase = _c2Now = shotHere ? 2 : 1;
+		AiProbe::tally(_unit, shotHere ? "c2.plan.here" : "c2.plan.fp");
+		AiProbe::note(_unit, (std::string(shotHere ? "c2.plan.here" : "c2.plan.fp") + " seen=" + std::to_string(seenFire)
+			+ " shots=" + std::to_string(shots) + " shot=" + std::to_string(shot.Time) + " walk=" + std::to_string(walkFire)
+			+ " exit=" + std::to_string(exitFire) + " left=" + std::to_string(leftFire) + " tu=" + std::to_string(tu)).c_str());
+		return;
+	}
+	if (_c2MovedTurn == turn)
+	{
+		AiProbe::tally(_unit, "c2.skip.moved"); // one walk to a fire cell of its own a turn
+		return;
+	}
+	// another fire cell near it: the same target in sight, not farther from it, no shot fewer, no more lines of fire on it,
+	// the way out after the shots; the cheapest walk
+	const int distFire = Position::distance2d(fire, target->getPosition());
+	Position best;
+	int bestWalk = INT_MAX, bestExit = INT_MAX, tried = 0;
+	for (const auto &cell : reachTu)
+	{
+		const Position pos = _save->getTileCoords(cell.first);
+		const int walk = cell.second;
+		if (pos == fire || walk >= bestWalk || Position::distance2d(pos, fire) > 3 || std::abs(pos.z - fire.z) > 1)
+			continue;
+		if (shotsAfter(walk) < shots || Position::distance2d(pos, target->getPosition()) > distFire + 1)
+			continue;
+		const Tile *tile = _save->getTile(pos);
+		if (!tile || tile->getFire() || tile->getDangerous() || (tile->getUnit() && tile->getUnit() != _unit))
+			continue;
+		const int left = tu - walk - kneelDown - shots * shot.Time - stand;
+		if (left <= 0)
+			continue;
+		++tried;
+		Position origin = pos.toVoxel() + Position(8, 8, _unit->getHeight() + _unit->getFloatHeight() - tile->getTerrainLevel() - 4);
+		Position aim;
+		if (!_save->getTileEngine()->canTargetUnit(&origin, target->getTile(), &aim, _unit, false))
+			continue;
+		if (lof(pos) > seenFire)
+			continue;
+		const int exit = pos == here ? exitHere(left) : exitFrom(pos, left);
+		if (exit == INT_MAX)
+			continue;
+		best = pos;
+		bestWalk = walk;
+		bestExit = exit;
+	}
+	if (bestWalk == INT_MAX)
+	{
+		AiProbe::tally(_unit, "c2.none");
+		return;
+	}
+	if (best != here)
+	{
+		// the walk itself, as the engine will take it: it fits the time units and the energy the plan counted
+		pf->calculate(_unit, best, BAM_NORMAL);
+		const bool path = pf->getStartDirection() != -1;
+		const PathfindingCost cost = c2WalkCost(pf, _unit);
+		pf->abortPath();
+		if (!path || cost.time + kneelDown + shots * shot.Time + stand + bestExit > tu
+			|| cost.energy + shots * shot.Energy > _unit->getEnergy())
+		{
+			AiProbe::tally(_unit, "c2.none.path");
+			return;
+		}
+		_attackAction.type = BA_WALK;
+		_attackAction.target = best;
+		_attackAction.run = false;
+		_attackAction.finalFacing = _save->getTileEngine()->getDirectionTo(best, target->getPosition());
+	}
+	_c2Fire = best;
+	_c2Turn = turn;
+	_c2Kind = best == here ? 1 : 3;
+	_c2Phase = _c2Now = best == here ? 2 : 1;
+	AiProbe::tally(_unit, best == here ? "c2.plan.here" : "c2.plan.move");
+	AiProbe::note(_unit, (std::string(best == here ? "c2.plan.here" : "c2.plan.move") + " seen=" + std::to_string(seenFire)
+		+ ">" + std::to_string(lof(best)) + " shots=" + std::to_string(shots) + " shot=" + std::to_string(shot.Time)
+		+ " walk=" + std::to_string(bestWalk) + " exit=" + std::to_string(bestExit) + " dist=" + std::to_string(Position::distance2d(fire, best))
+		+ " tried=" + std::to_string(tried) + " tu=" + std::to_string(tu)).c_str());
+}
+
+void AIModule::c2ShotDone()
+{
+	if (_unit->getFaction() != FACTION_HOSTILE || _save->getSide() != FACTION_HOSTILE)
+		return;
+	if ((_c2Phase == 2 || _c2Phase == 3) && _c2Turn == _save->getTurn() && _unit->getPosition() == _c2Fire)
+	{
+		_c2Phase = 3;
+		_c2ShotTu = _unit->getTimeUnits();
+		AiProbe::tally(_unit, "c2.confirm");
+	}
+}
+
+bool AIModule::c2Exit(BattleAction *action)
+{
+	// another shot it can still buy: the unit decides as before, the exit waits for after that shot
+	BattleItem *weapon = _unit->getMainHandWeapon(false);
+	if (weapon && weapon->haveAnyAmmo() && _save->canUseWeapon(weapon, _unit, false, BA_NONE))
+	{
+		for (BattleActionType t : { BA_SNAPSHOT, BA_AUTOSHOT, BA_AIMEDSHOT })
+		{
+			BattleActionCost cost(t, _unit, weapon);
+			if (cost.Time > 0 && cost.haveTU())
+			{
+				AiProbe::tally(_unit, "c2.exit.wait");
+				return false;
+			}
+		}
+	}
+	_c2Phase = 0;
+	const std::vector<BattleUnit*> threats = c2Threats();
+	const Position from = _unit->getPosition();
+	const int seenBy = c2Lof(threats, from);
+	if (seenBy == 0)
+	{
+		AiProbe::tally(_unit, "c2.exit.safe");
+		return false;
+	}
+	// the cheapest reachable cell out of every seen enemy's line of fire (standing up first if it kneels)
+	BattleActionCost keep;
+	keep.Time = _unit->isKneeled() ? _unit->getKneelUpCost() : 0;
+	Pathfinding *pf = _save->getPathfinding();
+	int tried = 0;
+	for (int index : pf->findReachable(_unit, keep))
+	{
+		const Position pos = _save->getTileCoords(index);
+		const Tile *tile = _save->getTile(pos);
+		if (pos == from || !tile || tile->getFire() || tile->getDangerous())
+			continue;
+		if (++tried > 40)
+			break;
+		if (c2Lof(threats, pos) != 0)
+			continue;
+		pf->calculate(_unit, pos, BAM_NORMAL);
+		const bool path = pf->getStartDirection() != -1;
+		const PathfindingCost cost = c2WalkCost(pf, _unit);
+		pf->abortPath();
+		if (!path || cost.time + keep.Time > _unit->getTimeUnits() || cost.energy > _unit->getEnergy())
+			continue;
+		action->type = BA_WALK;
+		action->target = pos;
+		action->run = false;
+		action->kneel = false;
+		action->desperate = true; // to the cell, not stopping at the next enemy spotted on the way
+		action->finalAction = true; // the unit's turn ends there
+		action->finalFacing = -1; // no turn at the walk's end: the time units go on the path only
+		_unit->setHiding(false);
+		_unit->setCharging(0);
+		_escapeTUs = 0;
+		_ambushTUs = 0;
+		if (AiProbe::staleEscapeFix())
+			_escapePlan.valid = false;
+		AiProbe::tally(_unit, "c2.exit");
+		AiProbe::note(_unit, ("c2.exit seen=" + std::to_string(seenBy) + " tried=" + std::to_string(tried)
+			+ " dist=" + std::to_string(Position::distance2d(from, pos)) + " cost=" + std::to_string(cost.time)
+			+ " stand=" + std::to_string(keep.Time) + " tu=" + std::to_string(_unit->getTimeUnits())).c_str());
+		return true;
+	}
+	AiProbe::tally(_unit, "c2.noexit");
+	AiProbe::note(_unit, ("c2.noexit seen=" + std::to_string(seenBy) + " tried=" + std::to_string(tried)
+		+ " tu=" + std::to_string(_unit->getTimeUnits())).c_str());
+	return false;
 }
 
 
