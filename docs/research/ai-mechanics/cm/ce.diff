+/// COORDINATED_ENGAGEMENT_V1 (bench): one group per known target and hostile turn - the able hostiles near the place the side
+/// knows the target to be, frozen when the first hostile whose closest known target it is thinks in this turn
+struct CeGroup
+{
+	int id = 0;
+	std::vector<int> members;
+	std::vector<int> attacked; // members whose decision in this turn was an attack, made before the decider's own
+};
+
+struct CeUnit
+{
+	int holdTurn = -1, streak = 0;
+};
+
+struct CeState
+{
+	const SavedBattleGame *save = 0;
+	int turn = -1, nextId = 0;
+	std::map<int, CeGroup> groups; // target id -> its group of this turn
+	std::map<int, CeUnit> units;
+};
+CeState ce;
+
+bool ceAttack(BattleActionType t)
+{
+	return t == BA_THROW || t == BA_AUTOSHOT || t == BA_SNAPSHOT || t == BA_AIMEDSHOT || t == BA_HIT || t == BA_LAUNCH
+		|| t == BA_MINDCONTROL || t == BA_PANIC;
+}
+
+/// A ranged weapon in hand the unit may use, with ammo.
+BattleItem *ceRanged(SavedBattleGame *save, BattleUnit *bu)
+{
+	BattleItem *w = bu->getMainHandWeapon(false);
+	if (!w || w->getRules()->getBattleType() != BT_FIREARM || !save->canUseWeapon(w, bu, false, BA_NONE) || !w->haveAnyAmmo())
+		return 0;
+	return w;
+}
+
+/// Why a live hostile cannot fight for its group, or 0.
+const char *ceUnable(SavedBattleGame *save, BattleUnit *bu)
+{
+	if (bu->getStatus() == STATUS_PANICKING || bu->getStatus() == STATUS_BERSERK)
+		return "panic";
+	if (bu->getAIModule() && bu->getAIModule()->getAIMode() == AI_ESCAPE)
+		return "escape";
+	if (bu->getHealth() < 2 * bu->getBaseStats()->health / 3)
+		return "hurt";
+	if (!ceRanged(save, bu))
+		return "noranged";
+	return 0;
+}
+
+/// Can the unit attack the target now, from where it stands and with the time units it has: a ranged weapon with ammo, a shot
+/// it can pay for, the place the side knows the target to be within the weapon's range and a line to it from its eyes.
+bool ceCanFireNow(SavedBattleGame *save, BattleUnit *bu, BattleUnit *target, Position kp)
+{
+	BattleItem *w = ceRanged(save, bu);
+	if (!w)
+		return false;
+	bool pay = false;
+	for (BattleActionType t : { BA_SNAPSHOT, BA_AUTOSHOT, BA_AIMEDSHOT })
+	{
+		BattleActionCost cost(t, bu, w);
+		pay = pay || (cost.Time > 0 && cost.haveTU());
+	}
+	Tile *tile = save->getTile(kp);
+	if (!pay || !tile || w->getRules()->isOutOfRange(Position::distanceSq(bu->getPosition(), kp)))
+		return false;
+	Position origin = save->getTileEngine()->getSightOriginVoxel(bu);
+	origin.z -= 2;
+	Position voxel;
+	return save->getTileEngine()->canTargetUnit(&origin, tile, &voxel, bu, false, target->getPosition() == kp ? 0 : target);
+}
+
+std::string ceList(const std::vector<int> &ids)
+{
+	std::ostringstream s;
+	for (size_t i = 0; i < ids.size(); ++i)
+		s << (i ? "," : "") << ids[i];
+	return ids.empty() ? "-" : s.str();
+}
