+/// HIVE D2, only written: all a field can depend on: the unit, where everyone is and who has been seen, the map with its fire and smoke.
+uint64_t fieldState(SavedBattleGame *save, const BattleUnit *u)
+{
+	uint64_t h = 1469598103934665603ULL;
+	const auto mix = [&h](uint64_t v) { h = (h ^ v) * 1099511628211ULL; };
+	mix(u->getId());
+	mix(u->getUnitsSpottedThisTurn().size());
+	for (auto *o : *save->getUnits())
+	{
+		const Position p = o->getPosition();
+		mix(o->getId());
+		mix(o->isOut() ? 1 : 0);
+		mix(p.x + p.y * 1000 + p.z * 1000000);
+		mix(o->getTurnsSinceSpottedByFaction(FACTION_HOSTILE) == 0 ? 1 : 0);
+	}
+	for (int i = 0; i < save->getMapSizeXYZ(); ++i)
+	{
+		Tile *t = save->getTile(i);
+		for (int part = 0; part < O_MAX; ++part)
+		{
+			mix((uint64_t)(uintptr_t)t->getMapData((TilePart)part));
+		}
+		mix(t->getFire() * 100 + t->getSmoke());
+	}
+	return h;
+}
