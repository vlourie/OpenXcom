+void patrolEnded(SavedBattleGame *save, BattleUnit *unit, const PatrolTally &tally, const Node *result)
+{
+	if (tally.taken == 0)
+	{
+		hq.unusedFloods += hq.pendingFloods;
+		hq.unusedFloodNs += hq.pendingFloodNs;
+	}
+	hq.pendingFloods = 0;
+	hq.pendingFloodNs = 0;
+	Log(LOG_INFO) << "[HIVEUA] event=PATROLEND turn=" << save->getTurn() << " unit=" << unit->getId() << " at=" << pos(unit->getPosition()) << " tries=" << tally.tries << " free_checked=" << tally.freeChecked << " free_none=" << tally.freeNone
+		<< " offers=" << tally.offers << " refused=" << tally.refusals << " taken=" << tally.taken << " end=" << (result ? pos(const_cast<Node *>(result)->getPosition()) : std::string("none")) << " tu=" << unit->getTimeUnits();
+}
