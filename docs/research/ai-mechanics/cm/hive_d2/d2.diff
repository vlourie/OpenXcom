+void offerRefused(SavedBattleGame *save, BattleUnit *unit, const Node *offer, PatrolTally &tally, int tryNo, long long ns, int expanded, bool seedMoved)
+{
+	const int turn = save->getTurn(), id = unit->getId();
+	tally.refused.push_back(offer);
+	tally.refusals++;
+	hq.offersMade++;
+	hq.offersRefused++;
+	hq.offerRefusedNs += ns;
+	hq.maxOfferRefusedNs = std::max(hq.maxOfferRefusedNs, ns);
+	hq.seedMoved += seedMoved ? 1 : 0;
+	Log(LOG_INFO) << "[HIVEUA] event=OFFER_REFUSED turn=" << turn << " unit=" << id << " try=" << tryNo << " at=" << pos(unit->getPosition()) << " offer=" << pos(const_cast<Node *>(offer)->getPosition())
+		<< " free=" << (tally.free ? pos(tally.free->getPosition()) : std::string("(-1,-1,-1)")) << " expanded=" << expanded << " us=" << ns / 1000 << " seed_moved=" << (seedMoved ? 1 : 0);
+	hq.fellBack[id] = turn;
+	if (tally.free)
+	{
+		Choice &c = hq.choices[id];
+		c.node = tally.free->getPosition();
+		c.changed = false;
+	}
+	else
+	{
+		hq.choices.erase(id);
+	}
+}
+
+void offerTaken(PatrolTally &tally, long long ns)
+{
+	tally.taken++;
+	hq.offersMade++;
+	hq.offersTaken++;
+	hq.offerTakenNs += ns;
+}
