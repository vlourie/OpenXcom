+/// SIDE_TURN_ACTION_SCHEDULER: the side turn the scheduler works in, whether its first unit was chosen, the units activated in
+/// the current round of the first pass, the picks made
+const SavedBattleGame *schedSave = nullptr;
+int schedTurn = -1, schedSide = -1, schedPicks = 0;
+bool schedStarted = false;
+std::set<int> schedVisited;
+
+void schedKey(const SavedBattleGame *save)
+{
+	// a new side turn, or another battle (a load in the middle of a turn gives a new SavedBattleGame: the engine also starts
+	// its first pass afresh then - _AISecondMove is not saved)
+	if (save != schedSave || save->getTurn() != schedTurn || (int)save->getSide() != schedSide)
+	{
+		schedSave = save;
+		schedTurn = save->getTurn();
+		schedSide = (int)save->getSide();
+		schedPicks = 0;
+		schedStarted = false;
+		schedVisited.clear();
+	}
+}
+
+/// Can the unit attack a player unit it sees from where it stands now: its main weapon's cheapest shot (the time units and the
+/// ammo for it), the weapon's range and the engine's line of fire from the weapon (the test of AIModule::selectNearestTarget);
+/// or a melee hit on an adjacent one it sees. Only what the unit itself sees and has; reads only, no RNG. The target's id, or -1.
+int schedAttack(SavedBattleGame *save, BattleUnit *u)
+{
+	TileEngine *te = save->getTileEngine();
+	BattleItem *w = u->getMainHandWeapon(false);
+	if (w && w->getRules()->getBattleType() == BT_FIREARM)
+	{
+		bool shot = false;
+		for (BattleActionType t : { BA_SNAPSHOT, BA_AUTOSHOT, BA_AIMEDSHOT })
+		{
+			BattleActionCost cost(t, u, w);
+			if (cost.Time > 0 && static_cast<const BattleItem *>(w)->getAmmoForAction(t) && cost.haveTU())
+			{
+				shot = true;
+				break;
+			}
+		}
+		if (shot)
+		{
+			for (BattleUnit *bu : *u->getVisibleUnits())
+			{
+				if (bu->isOut() || bu->getFaction() != FACTION_PLAYER || !bu->getTile()
+					|| w->getRules()->isOutOfRange(Position::distanceSq(u->getPosition(), bu->getPosition())))
+				{
+					continue;
+				}
+				BattleAction a;
+				a.actor = u;
+				a.weapon = w;
+				a.type = BA_SNAPSHOT;
+				a.target = bu->getPosition();
+				Position origin = te->getOriginVoxel(a, 0), scan;
+				if (te->canTargetUnit(&origin, bu->getTile(), &scan, u, false))
+				{
+					return bu->getId();
+				}
+			}
+		}
+	}
+	BattleItem *m = u->getUtilityWeapon(BT_MELEE);
+	if (m)
+	{
+		BattleActionCost cost(BA_HIT, u, m);
+		if (cost.Time > 0 && cost.haveTU())
+		{
+			for (BattleUnit *bu : *u->getVisibleUnits())
+			{
+				if (!bu->isOut() && bu->getFaction() == FACTION_PLAYER && bu->getTile()
+					&& te->validMeleeRange(u, bu, te->getDirectionTo(u->getPosition(), bu->getPosition())))
+				{
+					return bu->getId();
+				}
+			}
+		}
+	}
+	return -1;
+}
+
+/// The choice among the candidates (vector order): the lowest one with an attack, else the lowest; logged as [AISCHED].
+BattleUnit *schedChoose(SavedBattleGame *save, const std::vector<BattleUnit *> &cands, const BattleUnit *left, int pass,
+	bool wrapped, const char *site)
+{
+	const auto t0 = std::chrono::steady_clock::now();
+	BattleUnit *order = cands.empty() ? nullptr : cands.front();
+	BattleUnit *chosen = nullptr;
+	int aim = -1;
+	std::ostringstream list;
+	for (BattleUnit *bu : cands)
+	{
+		const int t = schedAttack(save, bu);
+		list << (list.tellp() > 0 ? "," : "") << bu->getId() << ":" << (t >= 0 ? "a" : "-") << bu->getTimeUnits();
+		if (t >= 0 && !chosen)
+		{
+			chosen = bu;
+			aim = t;
+		}
+	}
+	const bool attack = chosen != nullptr;
+	if (!chosen)
+	{
+		chosen = order;
+	}
+	++schedPicks;
+	const long long us = std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count();
+	Log(LOG_INFO) << "[AISCHED] us=" << us << " turn=" << save->getTurn() << " side=" << (int)save->getSide() << " pick=" << schedPicks
+		<< " pass=" << pass << " site=" << site << " wrap=" << (wrapped ? 1 : 0)
+		<< " left=" << (left ? left->getId() : -1) << " order=" << (order ? order->getId() : -1)
+		<< " chosen=" << (chosen ? chosen->getId() : -1) << " why=" << (!chosen ? "none" : attack ? (chosen == order ? "attack.same" : "attack") : "order")
+		<< " aim=" << aim << " cands=" << (list.tellp() > 0 ? list.str() : "-");
+	if (chosen)
+	{
+		schedVisited.insert(chosen->getId());
+	}
+	return chosen;
+}
+}
+
+bool schedActive(const SavedBattleGame *save)
+{
+	static const bool on = active() && envOn("OXCE_AI_SCHEDULER");
+	return on && save->getSide() == FACTION_HOSTILE && !botTurn(save);
+}
+
+BattleUnit *schedFirst(SavedBattleGame *save, BattleUnit *unit)
+{
+	if (!schedActive(save))
+	{
+		return nullptr;
+	}
+	schedKey(save);
+	if (schedStarted)
+	{
+		return nullptr;
+	}
+	schedStarted = true;
+	// the engine's first round runs from the selected unit to the vector's end: at a turn's start that is the first selectable
+	// one, after a load in the middle of a turn the saved one - the units before it count as visited in this round, as there
+	std::vector<BattleUnit *> cands;
+	bool before = unit != nullptr;
+	for (auto *bu : *save->getUnits())
+	{
+		before = before && bu != unit;
+		if (before)
+		{
+			schedVisited.insert(bu->getId());
+		}
+		else if (bu->isSelectable(save->getSide(), true, false))
+		{
+			cands.push_back(bu);
+		}
+	}
+	if (cands.empty())
+	{
+		schedVisited.clear();
+		return nullptr;
+	}
+	BattleUnit *chosen = schedChoose(save, cands, nullptr, 1, false, "first");
+	return chosen && chosen != unit ? chosen : nullptr;
+}
+
+BattleUnit *schedPick(SavedBattleGame *save, bool setReselect, bool secondMove, bool *wrapped, const char *site)
+{
+	schedKey(save);
+	schedStarted = true;
+	BattleUnit *left = save->getSelectedUnit();
+	if (left && setReselect)
+	{
+		left->dontReselect(); // as SavedBattleGame::selectPlayerUnit
+	}
+	// first pass: the ones not yet activated in this round; second pass: every one not flagged (each is flagged as it leaves)
+	auto candidates = [&]()
+	{
+		std::vector<BattleUnit *> c;
+		for (auto *bu : *save->getUnits())
+		{
+			if (bu->isSelectable(save->getSide(), true, false) && (secondMove || !schedVisited.count(bu->getId())))
+			{
+				c.push_back(bu);
+			}
+		}
+		return c;
+	};
+	// no selection (the active unit died or left the side: SavedBattleGame::clearUnitSelection): the engine's walk starts again
+	// from the vector's start without the second pass - a new first-pass round, as there
+	const bool restart = !left && !secondMove;
+	if (restart)
+	{
+		schedVisited.clear();
+	}
+	std::vector<BattleUnit *> cands = candidates();
+	bool wrap = false;
+	if (cands.empty() && !secondMove)
+	{
+		// every unit had its turn in this round: the engine's selection wraps round to the vector's start here
+		wrap = true;
+		schedVisited.clear();
+		cands = candidates();
+	}
+	if (wrapped)
+	{
+		*wrapped = wrap;
+	}
+	const std::string where = std::string(site) + (restart ? ".restart" : "");
+	BattleUnit *chosen = schedChoose(save, cands, left, secondMove ? 2 : 1, wrap, where.c_str());
+	save->setSelectedUnit(chosen);
+	return chosen;
+}
