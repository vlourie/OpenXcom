+/// COUNTERFIRE V0: the built-in weapon of a player vehicle that answers with a blast - a player unit that is no soldier, a fixed
+/// firearm with a snap or auto shot (what reaction fire uses), and among the ammo the rules let it load (or its own power when it
+/// needs none) one whose damage is area and hurts health. Rules only: what it can load, not what it has loaded. nullptr if none.
+const RuleItem *blastCounter(const BattleUnit *target)
+{
+	if (target->getOriginalFaction() != FACTION_PLAYER || target->getGeoscapeSoldier() != nullptr)
+		return nullptr;
+	auto blast = [](const RuleItem *r)
+	{
+		const RuleDamageType *dt = r ? r->getDamageType() : nullptr;
+		return dt && !dt->isDirect() && dt->ToHealth > 0.0f && r->getPower() > 0;
+	};
+	for (const BattleItem *bi : *target->getInventory())
+	{
+		const RuleItem *w = bi->getRules();
+		if (!w->isFixed() || w->getBattleType() != BT_FIREARM || (w->getCostSnap().Time <= 0 && w->getCostAuto().Time <= 0))
+			continue;
+		bool any = false;
+		for (int slot = 0; slot < RuleItem::AmmoSlotMax; ++slot)
+		{
+			for (const RuleItem *a : *w->getCompatibleAmmoForSlot(slot))
+			{
+				any = true;
+				if (blast(a))
+					return w;
+			}
+		}
+		if (!any && blast(w))
+			return w;
+	}
+	return nullptr;
+}
