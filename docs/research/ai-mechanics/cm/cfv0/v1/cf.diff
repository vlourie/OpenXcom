+/// COUNTERFIRE V0: the most hopeful health damage of the attack to the target, by the rules: every shot and every pellet hits,
+/// the power the attacker's own weapon, ammo and stats give (ExplosionBState::init) without the range dropoff, the armor's
+/// ruleset modifier for the damage's resist type, the ruleset armor of the side the shot comes from by the target's place and
+/// facing the shooter sees (as AIModule::fireModeEffect), the expected roll, times ToHealth. Read: the attacker's own items and
+/// stats, the seen target's place and facing, its armor rule; not read: its current health and armor, TU, reactions. 'other'
+/// names an effect beyond health that keeps the attack: area damage, an incendiary or smoke damage type, transformation, armor
+/// damage (ToArmorPre on the roll, ToArmor past the armor) of 10% of that side's armor or more, or status damage (stun, time,
+/// energy, morale or mana above ToHealth) that the best roll gets past the armor. A direct hit makes no smoke or fire: hitTile
+/// runs only when the shot hits no unit (TileEngine::hit). -1 when not modelled.
+double cfBenefit(SavedBattleGame *save, BattleUnit *unit, const BattleAction &action, const BattleUnit *target,
+	const char *&other, int &power, int &shots, double &sideArmor, double &armorLoss)
+{
+	other = nullptr;
+	power = 0;
+	shots = 1;
+	sideArmor = 0.0;
+	armorLoss = 0.0;
+	if (!action.weapon)
+	{
+		other = "no_weapon";
+		return -1.0;
+	}
+	BattleActionAttack attack = BattleActionAttack::GetBeforeShoot(action);
+	if (!attack.damage_item)
+	{
+		other = "no_ammo";
+		return -1.0;
+	}
+	const RuleItem *weapon = action.weapon->getRules();
+	const RuleItem *item = attack.damage_item->getRules();
+	const RuleDamageType *dt = nullptr;
+	if (action.type == BA_HIT && item->getBattleType() != BT_MELEE)
+	{
+		power = item->getMeleeBonus(attack);
+		dt = item->getMeleeType();
+	}
+	else
+	{
+		power = action.type != BA_HIT && weapon->getIgnoreAmmoPower() ? weapon->getPowerBonus(attack) : item->getPowerBonus(attack);
+		dt = item->getDamageType();
+		if (item->getExplosionRadius(attack) != 0)
+		{
+			other = "area";
+			return -1.0;
+		}
+	}
+	if (!dt)
+	{
+		other = "no_damage_type";
+		return -1.0;
+	}
+	power = std::max(power, 0);
+	if (!dt->isDirect())
+		other = "area";
+	else if (dt->ResistType == DT_SMOKE || dt->ResistType == DT_IN)
+		other = "smoke_fire";
+	else if (!item->getZombieUnit(target).empty() && !target->getArmor()->getZombiImmune())
+		other = "transform";
+	if (action.type == BA_AUTOSHOT)
+		shots = weapon->getConfigAuto()->shots;
+	else if (action.type == BA_SNAPSHOT)
+		shots = weapon->getConfigSnap()->shots;
+	else if (action.type == BA_AIMEDSHOT)
+		shots = weapon->getConfigAimed()->shots;
+	if (action.type != BA_HIT && action.type != BA_THROW && item->getShotgunPellets() > 1)
+		shots *= item->getShotgunPellets();
+	shots = std::max(shots, 1);
+
+	// BattleUnit::damage: the side of the hit by the direction from the target to the shooter (the seen place and facing)
+	const Armor *armor = target->getArmor();
+	sideArmor = armor->getFrontArmor();
+	if (!dt->IgnoreDirection)
+	{
+		const Position rel = (unit->getPosition() - target->getPosition()) * Position(16, 16, 24);
+		if (rel.x == 0 && rel.y == 0 && rel.z <= 0)
+		{
+			sideArmor = armor->getUnderArmor();
+		}
+		else
+		{
+			int relativeDirection;
+			const int abs_x = abs(rel.x);
+			const int abs_y = abs(rel.y);
+			if (abs_y > abs_x * 2)
+				relativeDirection = 8 + 4 * (rel.y > 0);
+			else if (abs_x > abs_y * 2)
+				relativeDirection = 10 + 4 * (rel.x < 0);
+			else if (rel.x < 0)
+				relativeDirection = rel.y > 0 ? 13 : 15;
+			else
+				relativeDirection = rel.y > 0 ? 11 : 9;
+			const double front = armor->getFrontArmor(), right = armor->getRightSideArmor(), rear = armor->getRearArmor(),
+				left = armor->getLeftSideArmor();
+			switch ((relativeDirection - target->getDirection()) % 8)
+			{
+			case 0: sideArmor = front; break;
+			case 1: sideArmor = (2 * front + right) / 3; break;
+			case 2: sideArmor = right; break;
+			case 3: sideArmor = (2 * rear + right) / 3; break;
+			case 4: sideArmor = rear; break;
+			case 5: sideArmor = (2 * rear + left) / 3; break;
+			case 6: sideArmor = left; break;
+			default: sideArmor = (2 * front + left) / 3; break;
+			}
+		}
+	}
+	const float modifier = armor->getDamageModifier(dt->ResistType);
+	const float effectiveness = KnowledgeArmor::effectiveness(dt, unit, action.weapon, attack.damage_item, target, save);
+	const float armorCut = effectiveness > 0.0f ? (float)sideArmor * effectiveness : 0.0f;
+	auto afterArmor = [&](int roll)
+	{
+		int damage = (int)floor(roll * modifier);
+		damage -= armorCut;
+		return std::max(damage, 0);
+	};
+	// the expected roll after the modifier (ToArmorPre's base) and after the armor (the base of health, ToArmor and status)
+	double perHit = 0.0, preHit = 0.0;
+	int best = 0;
+	if (dt->RandomType == DRT_UFO_WITH_TWO_DICE)
+	{
+		const double n = (double)(power + 1) * (power + 1);
+		for (int s = 0; s <= 2 * power; ++s)
+		{
+			perHit += afterArmor(s) * (std::min(s, 2 * power - s) + 1) / n;
+			preHit += (int)floor(s * modifier) * (std::min(s, 2 * power - s) + 1) / n;
+		}
+		best = afterArmor(2 * power);
+	}
+	else
+	{
+		const int lo = dt->getRandomDamage(power, 1);
+		const int hi = dt->getRandomDamage(power, 2);
+		for (int d = lo; d <= hi; ++d)
+		{
+			perHit += afterArmor(d);
+			preHit += (int)floor(d * modifier);
+		}
+		perHit /= (hi - lo + 1);
+		preHit /= (hi - lo + 1);
+		best = afterArmor(hi);
+	}
+	armorLoss = (dt->ToArmorPre * preHit + dt->ToArmor * perHit) * shots;
+	const float status = std::max(std::max(dt->ToStun, dt->ToTime), std::max(std::max(dt->ToEnergy, dt->ToMorale), dt->ToMana));
+	if (!other && sideArmor > 0.0 && armorLoss >= 0.10 * sideArmor)
+		other = "armor";
+	else if (!other && best > 0 && status > dt->ToHealth)
+		other = "status";
+	return perHit * dt->ToHealth * shots;
+}
