+void counterfire(SavedBattleGame *save, BattleUnit *unit, BattleAction &action)
+{
+	static const bool on = []
+	{
+		const char *s = ai3Env("OXCE_AI_COUNTERFIRE");
+		return s && atoi(s) == 1;
+	}();
+	if (!on || unit->getFaction() != FACTION_HOSTILE || unit->getOriginalFaction() != FACTION_HOSTILE
+		|| save->getSide() != FACTION_HOSTILE)
+	{
+		return;
+	}
+	const bool attack = action.type == BA_AUTOSHOT || action.type == BA_SNAPSHOT || action.type == BA_AIMEDSHOT
+		|| action.type == BA_HIT || action.type == BA_THROW || action.type == BA_LAUNCH;
+	if (!attack)
+	{
+		return;
+	}
+	Tile *tile = save->getTile(action.target);
+	BattleUnit *target = tile ? tile->getUnit() : nullptr;
+	if (!target || target->isOut() || target->getFaction() != FACTION_PLAYER)
+	{
+		return;
+	}
+	const RuleItem *counter = blastCounter(target);
+	if (!counter)
+	{
+		return;
+	}
+	const char *other = nullptr;
+	int power = 0, shots = 1;
+	double sideArmor = 0.0, armorLoss = 0.0;
+	const double est = cfBenefit(save, unit, action, target, other, power, shots, sideArmor, armorLoss);
+	const int maxHp = target->getBaseStats()->health;
+	const std::vector<BattleUnit *> *seen = unit->getVisibleUnits();
+	const char *why = nullptr;
+	if (std::find(seen->begin(), seen->end(), target) == seen->end())
+		why = "cf_keep.unseen";
+	else if (target->isVIP())
+		why = "cf_keep.mission";
+	else if (other)
+		why = "cf_keep.other";
+	else if (est < 0.0)
+		why = "cf_keep.not_modelled";
+	else if (est >= 0.10 * maxHp)
+		why = "cf_keep.useful";
+	const bool cancel = !why;
+	if (cancel)
+		why = "cf_cancel";
+	Log(LOG_INFO) << "[AIORDER] turn=" << save->getTurn() << " unit=" << unit->getId() << " n=" << action.number << " arm=cf"
+		<< " status=" << why << " type=" << (int)action.type << " target=" << target->getId() << " tpos=" << target->getPosition()
+		<< " pos=" << unit->getPosition() << " tu=" << unit->getTimeUnits()
+		<< " weapon=" << action.weapon->getRules()->getType() << " power=" << power << " shots=" << shots
+		<< " est=" << est << " maxhp=" << maxHp << " side=" << sideArmor << " armorloss=" << armorLoss
+		<< " other=" << (other ? other : "-") << " counter=" << counter->getType();
+	if (cancel)
+	{
+		action.type = BA_NONE;
+	}
+}
