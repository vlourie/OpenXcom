+/// TACTICAL STAGE 2: one shooter's fire order - its shot types in turn (BA_*), how many were handed out, whether it ended.
+struct FireOrder
+{
+	std::vector<int> shots;
+	size_t next = 0;
+	bool over = false;
+};
+
+/// TACTICAL STAGE 2: the orders of the run, read once from the environment.
+struct OrderSpec
+{
+	int turn = -1, target = -1, avoidTurn = -1;
+	std::map<int, FireOrder> fire;
+};
+
+OrderSpec &orderSpec()
+{
+	static OrderSpec spec = []
+	{
+		OrderSpec o;
+		if (const char *s = ai3Env("OXCE_AI_ORDER_FIRE"))
+		{
+			const std::string v = s;
+			const size_t a = v.find(':'), b = a == std::string::npos ? a : v.find(':', a + 1);
+			if (b != std::string::npos)
+			{
+				o.turn = atoi(v.substr(0, a).c_str());
+				o.target = atoi(v.substr(a + 1, b - a - 1).c_str());
+				std::stringstream units(v.substr(b + 1));
+				std::string item;
+				while (std::getline(units, item, ','))
+				{
+					const size_t eq = item.find('=');
+					if (eq == std::string::npos)
+						continue;
+					FireOrder f;
+					std::stringstream types(item.substr(eq + 1));
+					std::string t;
+					while (std::getline(types, t, '.'))
+						f.shots.push_back(atoi(t.c_str()));
+					o.fire[atoi(item.substr(0, eq).c_str())] = f;
+				}
+			}
+		}
+		if (const char *s = ai3Env("OXCE_AI_ORDER_AVOID"))
+		{
+			o.avoidTurn = atoi(s);
+		}
+		return o;
+	}();
+	return spec;
+}
+
+/// TACTICAL STAGE 2, arm C: an attack whose effect on the target is nil by the rules - public knowledge, the item's damage type
+/// and the target's armor: the armor's modifier for the damage's resist type is 0, the hit is direct (no blast that reaches
+/// others), and it does nothing to a tile either (no tile damage, no smoke or fire threshold short of the never-default 1000).
+bool nilAttack(const BattleAction &action, const BattleUnit *target)
+{
+	if (!action.weapon || !target)
+		return false;
+	const BattleItem *ammo = action.type == BA_THROW || action.type == BA_HIT ? action.weapon
+		: static_cast<const BattleItem *>(action.weapon)->getAmmoForAction(action.type);
+	if (!ammo)
+		return false;
+	const RuleDamageType *dt = action.type == BA_HIT ? ammo->getRules()->getMeleeType() : ammo->getRules()->getDamageType();
+	return dt && dt->isDirect() && target->getArmor()->getDamageModifier(dt->ResistType) <= 0.0f && dt->ToTile <= 0.0f
+		&& dt->SmokeThreshold >= 1000 && dt->FireThreshold >= 1000;
+}
+
+void orderLine(SavedBattleGame *save, const BattleUnit *unit, const BattleAction &action, const char *arm, const char *status,
+	int idx, int type, int cost, const BattleUnit *target, int wasType, const Position &wasTo, int prime = 0)
+{
+	Log(LOG_INFO) << "[AIORDER] turn=" << save->getTurn() << " unit=" << unit->getId() << " n=" << action.number << " arm=" << arm
+		<< " status=" << status << " idx=" << idx << " type=" << type << " cost=" << cost
+		<< " target=" << (target ? target->getId() : -1)
+		<< " tpos=" << (target ? target->getPosition() : Position(-1, -1, -1))
+		<< " since=" << (target ? target->getTurnsSinceSpottedByFaction(FACTION_HOSTILE) : -1)
+		<< " pos=" << unit->getPosition() << " tu=" << unit->getTimeUnits()
+		<< " d0act=" << wasType << " d0to=" << wasTo << " prime=" << prime;
+}
+
+/// The grenade priming think() charged (AIModule::think, AI_COMBAT: the prime cost and 4 TU) given back (sign 1) or charged
+/// again (sign -1).
+void primeBack(BattleUnit *unit, const RuleItemUseCost &prime, int sign)
+{
+	RuleItemUseCost c;
+	c.Time = -sign * prime.Time;
+	c.Energy = -sign * prime.Energy;
+	c.Morale = -sign * prime.Morale;
+	c.Health = -sign * prime.Health;
+	c.Stun = -sign * prime.Stun;
+	c.Mana = -sign * prime.Mana;
+	unit->spendCost(c);
+	unit->setTimeUnits(unit->getTimeUnits() + sign * 4);
+}
