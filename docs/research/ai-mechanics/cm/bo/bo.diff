+void battleOrder(SavedBattleGame *save, BattleUnit *unit, BattleAction &action)
+{
+	OrderSpec &o = orderSpec();
+	if ((o.turn < 0 && o.avoidTurn < 0) || unit->getFaction() != FACTION_HOSTILE || save->getSide() != FACTION_HOSTILE)
+	{
+		return;
+	}
+	const int turn = save->getTurn();
+	const int wasType = action.type;
+	const Position wasTo = action.target;
+	auto it = o.fire.find(unit->getId());
+	if (turn == o.turn && it != o.fire.end() && !it->second.over)
+	{
+		FireOrder &f = it->second;
+		BattleUnit *target = nullptr;
+		for (auto *bu : *save->getUnits())
+		{
+			if (bu->getId() == o.target)
+			{
+				target = bu;
+				break;
+			}
+		}
+		BattleItem *weapon = unit->getMainHandWeapon();
+		int type = f.next < f.shots.size() ? f.shots[f.next] : BA_NONE;
+		int cost = 0;
+		Position kp;
+		int kd = 0;
+		const char *why = nullptr;
+		// D0's decision was a grenade throw: think() has already charged its priming; the order does not throw, so the
+		// charge goes back for the order's checks and stays back only if the order's shot is made
+		const bool primed = action.type == BA_THROW && action.weapon && action.weapon->getRules()->isGrenadeOrProxy();
+		RuleItemUseCost prime;
+		if (primed)
+		{
+			prime = unit->getActionTUs(BA_PRIME, action.weapon);
+			primeBack(unit, prime, 1);
+		}
+		if (f.next >= f.shots.size())
+			why = "done";
+		else if (!target || target->isOut())
+			why = "cancel.target_out";
+		else if (target->getTurnsSinceSpottedByFaction(FACTION_HOSTILE) != 0)
+			why = "cancel.target_unknown";
+		else if (fairKnowledge() && (!target->getAiSeen(FACTION_HOSTILE, kp, kd) || kp != target->getPosition()))
+			why = "cancel.target_place";
+		else if (!weapon || weapon->getRules()->getBattleType() != BT_FIREARM)
+			why = "cancel.no_weapon";
+		if (!why)
+		{
+			BattleActionCost c((BattleActionType)type, unit, weapon);
+			if ((c.Time <= 0 || !c.haveTU()) && type != BA_SNAPSHOT)
+			{
+				// the planned aimed shot no longer fits: the snap shot the plan falls back on
+				type = BA_SNAPSHOT;
+				c = BattleActionCost(BA_SNAPSHOT, unit, weapon);
+			}
+			cost = c.Time;
+			if (c.Time <= 0 || !c.haveTU())
+				why = "cancel.no_tu";
+			else if (weapon->needsAmmoForAction((BattleActionType)type)
+				&& !static_cast<const BattleItem *>(weapon)->getAmmoForAction((BattleActionType)type))
+				why = "cancel.no_ammo";
+		}
+		if (!why)
+		{
+			BattleAction shot;
+			shot.type = (BattleActionType)type;
+			shot.actor = unit;
+			shot.weapon = weapon;
+			shot.target = target->getPosition();
+			TileEngine *te = save->getTileEngine();
+			Position origin = te->getOriginVoxel(shot, nullptr), scan;
+			if (!te->canTargetUnit(&origin, target->getTile(), &scan, unit, false))
+				why = "cancel.no_lof";
+		}
+		if (why)
+		{
+			f.over = true;
+			if (primed)
+			{
+				primeBack(unit, prime, -1);
+			}
+			orderLine(save, unit, action, "fire", why, (int)f.next, type, cost, target, wasType, wasTo);
+		}
+		else
+		{
+			orderLine(save, unit, action, "fire", "shot", (int)f.next, type, cost, target, wasType, wasTo,
+				primed ? prime.Time + 4 : 0);
+			++f.next;
+			action.type = (BattleActionType)type;
+			action.target = target->getPosition();
+			action.weapon = weapon;
+			action.finalAction = false;
+			action.desperate = false;
+			action.run = false;
+		}
+	}
+	const bool attack = action.type == BA_AUTOSHOT || action.type == BA_SNAPSHOT || action.type == BA_AIMEDSHOT
+		|| action.type == BA_HIT || action.type == BA_THROW || action.type == BA_LAUNCH;
+	if (turn == o.avoidTurn && attack)
+	{
+		Tile *tile = save->getTile(action.target);
+		BattleUnit *victim = tile ? tile->getUnit() : nullptr;
+		if (victim && victim->getFaction() == FACTION_PLAYER && nilAttack(action, victim))
+		{
+			orderLine(save, unit, action, "avoid", "nil_attack", -1, action.type, 0, victim, wasType, wasTo);
+			action.type = BA_NONE;
+		}
+	}
+}
