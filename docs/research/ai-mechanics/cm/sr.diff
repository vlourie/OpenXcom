+/// STAGE_RALLY_V1 (OXCE_AI_STAGE_RALLY, bench only): the hostile side's plan of a turn - the contact (of the player units the
+/// side saw this or last turn, the one nearest the hostiles' centre) and the rally node, 6-12 tiles from it and seen by none of
+/// those units; a plan is kept while its contact unit stays known within 6 tiles of where the plan found it and its node unseen
+struct RallyPlan
+{
+	const SavedBattleGame *save = nullptr;
+	int turn = -1, id = 0, contactId = -1;
+	Position contact = Position(-1, -1, -1);
+	Node *node = nullptr;
+};
+RallyPlan rallyPlan;
+/// a hostile's part in the plan: its id; 0 going to the rally node, 1 waiting there since turn, 2 sent to the contact, 3 done
+struct RallyUnit { int plan = -1, phase = 0, since = -1; };
+std::map<int, RallyUnit> rallyUnits;
+
+/// does any of the side's fresh contacts see a unit standing at pos (the check of AIModule::getSpottingUnits)
+bool rallySeen(SavedBattleGame *save, BattleUnit *unit, const Position &pos, const std::vector<BattleUnit*> &known)
+{
+	Tile *tile = save->getTile(pos);
+	for (auto *bu : known)
+	{
+		if (Position::distance2d(pos, bu->getPosition()) > 20)
+		{
+			continue;
+		}
+		Position originVoxel = save->getTileEngine()->getSightOriginVoxel(bu);
+		originVoxel.z -= 2;
+		Position targetVoxel;
+		if (save->getTileEngine()->canTargetUnit(&originVoxel, tile, &targetVoxel, bu, false, unit))
+		{
+			return true;
+		}
+	}
+	return false;
+}
+
+/// a node this unit may walk to as getPatrolNode allows one (rank and flags aside)
+bool rallyNodeFits(SavedBattleGame *save, BattleUnit *unit, Node *n)
+{
+	Tile *tile = save->getTile(n->getPosition());
+	return !n->isDummy()
+		&& (!(n->getType() & Node::TYPE_SMALL) || unit->isSmallUnit())
+		&& (!(n->getType() & Node::TYPE_FLYING) || unit->getMovementType() == MT_FLY)
+		&& !(n->getType() & Node::TYPE_DANGEROUS)
+		&& tile && !tile->getFire() && !tile->getDangerous()
+		&& n->getPosition().x > 0 && n->getPosition().y > 0;
+}
+
+/// the plan of this turn: made at the first hostile patrol think of the turn
+const RallyPlan &rallyUpdate(SavedBattleGame *save, BattleUnit *unit)
+{
+	if (rallyPlan.save != save)
+	{
+		rallyPlan = RallyPlan();
+		rallyPlan.save = save;
+		rallyUnits.clear();
+	}
+	if (rallyPlan.turn == save->getTurn())
+	{
+		return rallyPlan;
+	}
+	rallyPlan.turn = save->getTurn();
+	std::vector<BattleUnit*> known;
+	int sx = 0, sy = 0, sz = 0, hostiles = 0;
+	for (auto *bu : *save->getUnits())
+	{
+		if (bu->isOut())
+		{
+			continue;
+		}
+		if (bu->getFaction() == FACTION_HOSTILE)
+		{
+			sx += bu->getPosition().x;
+			sy += bu->getPosition().y;
+			sz += bu->getPosition().z;
+			++hostiles;
+		}
+		else if (bu->getFaction() == FACTION_PLAYER && bu->getTurnsSinceSpottedByFaction(FACTION_HOSTILE) <= 1)
+		{
+			known.push_back(bu);
+		}
+	}
+	if (known.empty() || !hostiles)
+	{
+		if (rallyPlan.node)
+		{
+			Log(LOG_INFO) << "[AIPROBE] rally turn=" << rallyPlan.turn << " id=" << rallyPlan.id << " dropped known=" << known.size();
+			rallyPlan.node = nullptr;
+			++rallyPlan.id;
+		}
+		return rallyPlan;
+	}
+	const Position centre(sx / hostiles, sy / hostiles, sz / hostiles);
+	BattleUnit *contact = nullptr;
+	for (auto *bu : known)
+	{
+		if (rallyPlan.node && bu->getId() == rallyPlan.contactId)
+		{
+			// the plan's own contact is still known: the plan holds while it stays near and the node unseen
+			if (Position::distance2d(rallyPlan.contact, bu->getPosition()) <= 6
+				&& !rallySeen(save, unit, rallyPlan.node->getPosition(), known))
+			{
+				return rallyPlan;
+			}
+		}
+		if (!contact || Position::distanceSq(centre, bu->getPosition()) < Position::distanceSq(centre, contact->getPosition()))
+		{
+			contact = bu;
+		}
+	}
+	Node *best = nullptr;
+	for (auto *n : *save->getNodes())
+	{
+		const int d = Position::distance2d(contact->getPosition(), n->getPosition());
+		if (d < 6 || d > 12 || std::abs(n->getPosition().z - contact->getPosition().z) > 1 || !rallyNodeFits(save, unit, n))
+		{
+			continue;
+		}
+		if ((!best || Position::distanceSq(centre, n->getPosition()) < Position::distanceSq(centre, best->getPosition()))
+			&& !rallySeen(save, unit, n->getPosition(), known))
+		{
+			best = n;
+		}
+	}
+	rallyPlan.contact = contact->getPosition();
+	rallyPlan.contactId = contact->getId();
+	rallyPlan.node = best;
+	++rallyPlan.id;
+	const Position np = best ? best->getPosition() : Position(-1, -1, -1);
+	Log(LOG_INFO) << "[AIPROBE] rally turn=" << rallyPlan.turn << " id=" << rallyPlan.id << " contact=" << contact->getId()
+		<< "@(" << rallyPlan.contact.x << "," << rallyPlan.contact.y << "," << rallyPlan.contact.z << ") node=("
+		<< np.x << "," << np.y << "," << np.z << ") known=" << known.size() << " hostiles=" << hostiles;
+	return rallyPlan;
+}
+
+/// the free node this unit may walk to nearest centre, at most radius tiles from it (one level up or down)
+Node *rallySlot(SavedBattleGame *save, BattleUnit *unit, const Position &centre, int radius)
+{
+	Node *best = nullptr;
+	for (auto *n : *save->getNodes())
+	{
+		if (Position::distance2d(centre, n->getPosition()) > radius || std::abs(n->getPosition().z - centre.z) > 1
+			|| n->isAllocated() || !rallyNodeFits(save, unit, n) || !save->setUnitPosition(unit, n->getPosition(), true))
+		{
+			continue;
+		}
+		if (!best || Position::distanceSq(centre, n->getPosition()) < Position::distanceSq(centre, best->getPosition()))
+		{
+			best = n;
+		}
+	}
+	return best;
+}
+
+/// hostiles standing within 5 tiles of pos (one level up or down)
+int rallyGathered(SavedBattleGame *save, const Position &pos)
+{
+	int n = 0;
+	for (auto *bu : *save->getUnits())
+	{
+		n += !bu->isOut() && bu->getFaction() == FACTION_HOSTILE && Position::distance2d(pos, bu->getPosition()) <= 5
+			&& std::abs(pos.z - bu->getPosition().z) <= 1;
+	}
+	return n;
+}
