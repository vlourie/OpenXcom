+bool schedActive(const SavedBattleGame *save)
+{
+	static const bool on = active() && envOn("OXCE_AI_SCHEDULER");
+	return on && save->getSide() == FACTION_HOSTILE && !botTurn(save);
+}
+
+BattleUnit *schedFirst(SavedBattleGame *save, BattleUnit *unit)
+{
+	if (!schedActive(save))
+	{
+		return nullptr;
+	}
+	schedKey(save);
+	if (schedStarted)
+	{
+		return nullptr;
+	}
+	schedStarted = true;
+	// the engine's first round runs from the selected unit to the vector's end: at a turn's start that is the first selectable
+	// one, after a load in the middle of a turn the saved one - the units before it count as visited in this round, as there
+	std::vector<BattleUnit *> cands;
+	bool before = unit != nullptr;
+	for (auto *bu : *save->getUnits())
+	{
+		before = before && bu != unit;
+		if (before)
+		{
+			schedVisited.insert(bu->getId());
+		}
+		else if (bu->isSelectable(save->getSide(), true, false))
+		{
+			cands.push_back(bu);
+		}
+	}
+	if (cands.empty())
+	{
+		schedVisited.clear();
+		return nullptr;
+	}
+	BattleUnit *chosen = schedChoose(save, cands, nullptr, 1, false, "first");
+	return chosen && chosen != unit ? chosen : nullptr;
+}
+
+BattleUnit *schedPick(SavedBattleGame *save, bool setReselect, bool secondMove, bool *wrapped, const char *site)
+{
+	schedKey(save);
+	schedStarted = true;
+	BattleUnit *left = save->getSelectedUnit();
+	if (left && setReselect)
+	{
+		left->dontReselect(); // as SavedBattleGame::selectPlayerUnit
+	}
+	// first pass: the ones not yet activated in this round; second pass: every one not flagged (each is flagged as it leaves)
+	auto candidates = [&]()
+	{
+		std::vector<BattleUnit *> c;
+		for (auto *bu : *save->getUnits())
+		{
+			if (bu->isSelectable(save->getSide(), true, false) && (secondMove || !schedVisited.count(bu->getId())))
+			{
+				c.push_back(bu);
+			}
+		}
+		return c;
+	};
+	// no selection (the active unit died or left the side: SavedBattleGame::clearUnitSelection): the engine's walk starts again
+	// from the vector's start without the second pass - a new first-pass round, as there
+	const bool restart = !left && !secondMove;
+	if (restart)
+	{
+		schedVisited.clear();
+	}
+	std::vector<BattleUnit *> cands = candidates();
+	bool wrap = false;
+	if (cands.empty() && !secondMove)
+	{
+		// every unit had its turn in this round: the engine's selection wraps round to the vector's start here
+		wrap = true;
+		schedVisited.clear();
+		cands = candidates();
+	}
+	if (wrapped)
+	{
+		*wrapped = wrap;
+	}
+	const std::string where = std::string(site) + (restart ? ".restart" : "");
+	BattleUnit *chosen = schedChoose(save, cands, left, secondMove ? 2 : 1, wrap, where.c_str());
+	save->setSelectedUnit(chosen);
+	schedSaveAt(save, chosen);
+	return chosen;
+}
+
+bool schedCover(SavedBattleGame *save, BattleUnit *unit, Position &target)
+{
+	static const int coverMax = active() ? (int)param("OXCE_AI_SCHED_COVER", 0) : 0;
+	if (coverMax <= 0 || !unit || !schedActive(save))
+	{
+		return false;
+	}
+	schedKey(save);
+	// A first: only after an attack pick of this side turn; B has no attack of its own from where it stands now
+	if (schedCovers >= coverMax || schedAttackPicks == 0 || unit->getTurretType() != -1 || schedAttack(save, unit) >= 0)
+	{
+		return false;
+	}
+	// the weapon the engine reacts with for the AI side (TileEngine::determineReactionType: the quickest one) - a snap shot
+	BattleItem *w = unit->getMainHandWeapon(true, true);
+	if (!w || w->getRules()->getBattleType() != BT_FIREARM || !static_cast<const BattleItem *>(w)->getAmmoForAction(BA_SNAPSHOT))
+	{
+		return false;
+	}
+	BattleActionCost snap(BA_SNAPSHOT, unit, w);
+	if (snap.Time <= 0)
+	{
+		return false;
+	}
+	// the enemy to face: one its side sees now (no other knowledge), the nearest within the reaction distance
+	// (TileEngine::getSpottingUnits) and the snap shot's range
+	TileEngine *te = save->getTileEngine();
+	const BattleUnit *enemy = nullptr;
+	int best = INT_MAX;
+	for (BattleUnit *bu : *save->getUnits())
+	{
+		if (bu->getFaction() != FACTION_HOSTILE || bu->isOut())
+		{
+			continue;
+		}
+		for (BattleUnit *seen : *bu->getVisibleUnits())
+		{
+			if (seen->isOut() || seen->getFaction() != FACTION_PLAYER || !seen->getTile())
+			{
+				continue;
+			}
+			const int d = unit->distance3dToUnitSq(seen);
+			if (d < best && Position::distance2dSq(unit->getPosition(), seen->getPosition()) <= te->getMaxViewDistanceSq()
+				&& !w->getRules()->isOutOfRange(d))
+			{
+				best = d;
+				enemy = seen;
+			}
+		}
+	}
+	if (!enemy)
+	{
+		return false;
+	}
+	// the turn to face it is paid as usual (UnitTurnBState); the snap shot must stay affordable after it
+	const int face = unit->directionTo(enemy->getPosition());
+	const int diff = std::abs(face - unit->getDirection());
+	const int steps = std::min(diff, 8 - diff);
+	const int tuAfter = unit->getTimeUnits() - steps * unit->getTurnCost();
+	if (tuAfter < snap.Time)
+	{
+		return false;
+	}
+	++schedCovers;
+	if (coverTurn != save->getTurn())
+	{
+		coverTurn = save->getTurn();
+		coverIds.clear();
+	}
+	coverIds.insert(unit->getId());
+	target = enemy->getPosition();
+	Log(LOG_INFO) << "[AICOVER] turn=" << save->getTurn() << " side=" << (int)save->getSide() << " pick=" << schedPicks
+		<< " unit=" << unit->getId() << " pos=" << unit->getPosition() << " tu=" << unit->getTimeUnits() << " dir=" << unit->getDirection()
+		<< " face=" << face << " steps=" << steps << " tuAfter=" << tuAfter << " weapon=" << w->getRules()->getType()
+		<< " snapTU=" << snap.Time << " reactions=" << unit->getBaseStats()->reactions << " enemy=" << enemy->getId()
+		<< " epos=" << target << " distSq=" << best << " a=" << schedLastAttacker << " n=" << schedCovers;
+	return true;
+}
+
+bool coverWatch(const SavedBattleGame *save, const BattleUnit *bu)
+{
+	return coverTurn >= 0 && bu && save->getSide() == FACTION_PLAYER && save->getTurn() == coverTurn + 1 && coverIds.count(bu->getId());
+}
