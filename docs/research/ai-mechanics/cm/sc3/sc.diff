+/// SIDE_TURN_ACTION_SCHEDULER stage 3 (the bench): why the hostile side's own shot was dropped before it flew - [AISHOTCANCEL];
+/// for an arcing shot also the throw tests from here of the engine (Projectile::calculateThrow: the target unit's three voxels)
+/// and of AIModule (the one voxel it checked before the decision). Reads only, no RNG.
+static void aiShotCancel(BattlescapeGame *parent, BattleAction &action, const char *why)
+{
+	SavedBattleGame *save = parent->getSave();
+	if (!AiProbe::active() || !action.actor || action.actor->getFaction() != FACTION_HOSTILE || save->getSide() != FACTION_HOSTILE)
+	{
+		return;
+	}
+	std::ostringstream ss;
+	ss << "[AISHOTCANCEL] turn=" << save->getTurn() << " unit=" << action.actor->getId() << " type=" << (int)action.type
+		<< " why=" << why << " pos=" << action.actor->getPosition() << " dir=" << action.actor->getDirection()
+		<< " target=" << action.target << " tu=" << action.actor->getTimeUnits()
+		<< " distSq=" << action.actor->distance3dToPositionSq(action.target);
+	Tile *tt = save->getTile(action.target);
+	if (action.weapon && action.weapon->getArcingShot(action.type) && tt)
+	{
+		TileEngine *te = save->getTileEngine();
+		const Position origin = te->getOriginVoxel(action, 0);
+		BattleUnit *tu = tt->getOverlappingUnit(save);
+		ss << " origin=" << origin << " onTarget=" << (tu ? tu->getId() : -1) << " engine=";
+		if (tu)
+		{
+			Position base = action.target.toVoxel() + Position(8, 8, 1 - tt->getTerrainLevel() + tu->getFloatHeight());
+			for (int dz : { tu->getHeight() / 2 + 1, 2, tu->getHeight() - 1 })
+			{
+				ss << (te->validateThrow(action, origin, base + Position(0, 0, dz), save->getDepth()) ? 1 : 0);
+			}
+		}
+		else
+		{
+			ss << "-";
+		}
+		const Position ai = action.target.toVoxel() + Position(8, 8, 2 - tt->getTerrainLevel());
+		ss << " ai=" << (te->validateThrow(action, origin, ai, save->getDepth()) ? 1 : 0);
+	}
+	Log(LOG_INFO) << ss.str();
+}
+#define AI_SHOT_CANCEL(why) aiShotCancel(_parent, _action, why)
+#else
+#define AI_SHOT_CANCEL(why)
+#endif
