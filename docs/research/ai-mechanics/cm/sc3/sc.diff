+/// Stage 3 (OXCE_AI_SCHED_SAVEAT=<turn>:<pick>): the battle saved right after that pick of the side turn - the chosen unit is
+/// selected, its activation begins with the next think; to the user folder as sched_<turn>_<pick>.asav. Reads nothing back.
+void schedSaveAt(SavedBattleGame *save, const BattleUnit *chosen)
+{
+	static const std::pair<int, int> at = []
+	{
+		const char *s = getenv("OXCE_AI_SCHED_SAVEAT");
+		int t = 0, p = 0;
+		if (!active() || !s || sscanf(s, "%d:%d", &t, &p) != 2)
+		{
+			t = 0;
+		}
+		return std::make_pair(t, p);
+	}();
+	if (at.first <= 0 || save->getTurn() != at.first || schedPicks != at.second || !save->getBattleState())
+	{
+		return;
+	}
+	const std::string name = "sched_" + std::to_string(at.first) + "_" + std::to_string(at.second) + ".asav";
+	Game *game = save->getBattleState()->getGame();
+	game->getSavedGame()->save(name, game->getMod());
+	Log(LOG_INFO) << "[AISCHEDSAVE] turn=" << save->getTurn() << " side=" << (int)save->getSide() << " pick=" << schedPicks
+		<< " selected=" << (chosen ? chosen->getId() : -1) << " file=" << name;
+}
