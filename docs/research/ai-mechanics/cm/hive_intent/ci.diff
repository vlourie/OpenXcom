+/// COMBAT INTENT V0 (bench): a unit of the battle by its id.
+static BattleUnit *intentUnit(SavedBattleGame *save, int id)
+{
+	for (auto *bu : *save->getUnits())
+	{
+		if (bu->getId() == id) return bu;
+	}
+	return 0;
