              unit.getTag desync Tag.UNIT_RECOLOR_DESYNC;
              set temp anim_frame;
              add temp desync;
              wavegen_tri temp 16 16 15;
              mul temp -1;
              add temp 8;
              add_shade new_pixel temp;
            end;
          end;

          if eq animated 9;
            get_color color new_pixel;
            if eq color COLOR_X1_BROWN1;
              unit.getTag desync Tag.UNIT_RECOLOR_DESYNC;
              set temp anim_frame;
              add temp desync;
              wavegen_tri temp 16 16 15;
              mul temp -1;
