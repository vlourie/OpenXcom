#*** Flickering effects on unit sprite***
#*** Select pallette line to be animated: 1-15 are palette lines 1-15, numbers 16 and greater are palette line 0***
      - new: YSCRIPT_FLICKERING_COLORS
        offset: 98
        code: |
          var ptr RuleArmor armor_rule;
          var int animated;
          var int color;
          var int temp;
          var int desync;

          unit.getRuleArmor armor_rule;
          armor_rule.getTag animated Tag.ARMOR_FLICKERING_FLAG;

          if eq animated 1;
            get_color color new_pixel;
            if eq color COLOR_X1_YELLOW;
              unit.getTag desync Tag.UNIT_RECOLOR_DESYNC;
              set temp anim_frame;
              add temp desync;
              wavegen_tri temp 16 16 15;
              mul temp -1;
              add temp 8;
              add_shade new_pixel temp;
            end;
          end;

          if eq animated 2;
            get_color color new_pixel;
            if eq color COLOR_X1_RED;
              unit.getTag desync Tag.UNIT_RECOLOR_DESYNC;
              set temp anim_frame;
              add temp desync;
              wavegen_tri temp 16 16 15;
              mul temp -1;
              add temp 8;
              add_shade new_pixel temp;
            end;
          end;

          if eq animated 3;
            get_color color new_pixel;
            if eq color COLOR_X1_GREEN0;
              unit.getTag desync Tag.UNIT_RECOLOR_DESYNC;
